---
interface Props {
  currentPath?: string;
  isTransparent?: boolean;
}

const { currentPath = '/', isTransparent = true } = Astro.props;

const navItems = [
  { label: 'SOBRE NÓS', href: '/sobre-nos' },
  { label: 'PORTFÓLIO', href: '/nosso-projetos' },
  { label: 'CLIENTES', href: '/nossos-clientes' },
  { label: 'CONTATO', href: '/contato' },
];
---

<header id="site-header" class:list={['site-header', { 'is-transparent': isTransparent }]} role="banner">
  <div class="header-inner container">
    <!-- Logo -->
    <div class="site-logo">
      <a href="/" rel="home" aria-label="Bizsys - Ir para página inicial">
        <img
          src="/images/logo.png"
          alt="Bizsys"
          width="593"
          height="114"
          class="logo-img"
          loading="eager"
        />
      </a>
    </div>

    <!-- Navegação Desktop -->
    <nav class="desktop-navigation" aria-label="Navegação Principal">
      <ul class="nav-menu">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li class="nav-item">
              <a
                href={item.href}
                class:list={['nav-link', 'animated-link', { active: isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Ações do Header (Busca & Menu Hambúrguer) -->
    <div class="header-actions">
      <!-- Botão de Busca -->
      <button
        type="button"
        id="search-toggle-btn"
        class="header-icon-btn search-toggle"
        aria-label="Abrir formulário de busca"
        aria-controls="search-overlay"
        aria-expanded="false"
      >
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Botão Hambúrguer Mobile / Fullscreen -->
      <button
        type="button"
        id="mobile-menu-toggle-btn"
        class="header-icon-btn mobile-menu-toggle"
        aria-label="Abrir menu de navegação"
        aria-controls="mobile-fullscreen"
        aria-expanded="false"
      >
        <span class="grip-line"></span>
        <span class="grip-line"></span>
      </button>
    </div>
  </div>
</header>

<!-- Overlay de Busca -->
<div id="search-overlay" class="search-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Busca no site">
  <div class="search-overlay-inner container">
    <button type="button" id="search-close-btn" class="search-close-btn" aria-label="Fechar busca">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <form action="/busca" method="get" class="search-form">
      <label for="search-input" class="sr-only">Digite para buscar</label>
      <input
        type="search"
        id="search-input"
        name="q"
        placeholder="Digite o que procura e pressione Enter..."
        autocomplete="off"
      />
    </form>
  </div>
</div>

<!-- Menu Fullscreen Mobile -->
<div id="mobile-fullscreen" class="mobile-fullscreen" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menu principal">
  <div class="mobile-fullscreen-inner">
    <button type="button" id="mobile-close-btn" class="mobile-close-btn" aria-label="Fechar menu">
      <span class="close-x"></span>
    </button>

    <nav class="mobile-nav" aria-label="Menu Mobile">
      <ul class="mobile-nav-menu">
        <li class="mobile-nav-item">
          <a href="/" class:list={['mobile-nav-link', { active: currentPath === '/' }]}>HOME</a>
        </li>
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <li class="mobile-nav-item">
              <a href={item.href} class:list={['mobile-nav-link', { active: isActive }]}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Busca no menu mobile -->
    <div class="mobile-search-box">
      <form action="/busca" method="get" class="mobile-search-form">
        <input type="search" name="q" placeholder="Buscar..." aria-label="Buscar no site" />
        <button type="submit" aria-label="Buscar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </div>
  </div>
</div>

<style>
  /* Header Container */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: 1000;
    transition: background-color var(--transition-normal), backdrop-filter var(--transition-normal);
  }

  .site-header.is-transparent {
    background-color: transparent;
  }

  .site-header.is-scrolled {
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Logo */
  .site-logo {
    display: flex;
    align-items: center;
  }

  .logo-img {
    max-width: 125px;
    height: auto;
    max-height: 29px;
    object-fit: contain;
    transition: opacity var(--transition-fast);
  }

  .logo-img:hover {
    opacity: 0.85;
  }

  @media (max-width: 480px) {
    .logo-img {
      max-width: 100px;
    }
  }

  /* Desktop Nav */
  .desktop-navigation {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-navigation {
      display: block;
    }
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 14px;
    letter-spacing: 0.1em;
    font-weight: 300;
    color: var(--color-text);
    padding: 6px 0;
    text-transform: uppercase;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .header-icon-btn:hover {
    opacity: 0.75;
  }

  /* Hamburger Grip lines (fiel ao baseline OceanWP fa-grip-lines) */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 0 4px;
  }

  .grip-line {
    width: 22px;
    height: 2px;
    background-color: var(--color-text);
    border-radius: 1px;
    transition: transform var(--transition-normal);
  }

  /* Overlay de Busca */
  .search-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.96);
    backdrop-filter: blur(15px);
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }

  .search-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .search-overlay-inner {
    position: relative;
    width: 100%;
    max-width: 760px;
  }

  .search-close-btn {
    position: absolute;
    top: -60px;
    right: 24px;
    color: var(--color-text);
    padding: 8px;
    transition: opacity var(--transition-fast);
  }

  .search-close-btn:hover {
    opacity: 0.7;
  }

  .search-form input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
    padding: 16px 0;
    color: var(--color-text);
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 300;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search-form input:focus {
    border-color: #ffffff;
  }

  /* Menu Fullscreen Mobile */
  .mobile-fullscreen {
    position: fixed;
    inset: 0;
    background-color: rgba(5, 5, 5, 0.98);
    backdrop-filter: blur(20px);
    z-index: 2100;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }

  .mobile-fullscreen.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-fullscreen-inner {
    width: 100%;
    max-width: 500px;
    padding: 40px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .mobile-close-btn {
    position: absolute;
    top: 24px;
    right: 28px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .close-x {
    position: relative;
    width: 24px;
    height: 24px;
  }

  .close-x::before,
  .close-x::after {
    content: '';
    position: absolute;
    top: 11px;
    left: 0;
    width: 24px;
    height: 2px;
    background-color: #ffffff;
  }

  .close-x::before {
    transform: rotate(45deg);
  }

  .close-x::after {
    transform: rotate(-45deg);
  }

  .mobile-nav-menu {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 40px;
  }

  .mobile-nav-link {
    font-size: 24px;
    font-weight: 300;
    letter-spacing: 0.08em;
    color: #ffffff;
    display: inline-block;
    padding: 6px 0;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: #ffffff;
    opacity: 0.7;
    transform: translateY(-2px);
  }

  .mobile-search-box {
    width: 100%;
    max-width: 320px;
  }

  .mobile-search-form {
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding: 8px 0;
  }

  .mobile-search-form input {
    flex: 1;
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 300;
    outline: none;
  }

  .mobile-search-form button {
    color: rgba(255, 255, 255, 0.7);
    padding: 4px;
  }
</style>

<script>
  function setupHeader() {
    const header = document.getElementById('site-header');
    const searchToggle = document.getElementById('search-toggle-btn');
    const searchOverlay = document.getElementById('search-overlay');
    const searchClose = document.getElementById('search-close-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

    const menuToggle = document.getElementById('mobile-menu-toggle-btn');
    const mobileFullscreen = document.getElementById('mobile-fullscreen');
    const mobileClose = document.getElementById('mobile-close-btn');

    // Scroll state: add background on scroll
    function onScroll() {
      if (!header) return;
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Search Overlay
    function openSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.add('is-open');
      searchOverlay.setAttribute('aria-hidden', 'false');
      searchToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => searchInput?.focus(), 150);
    }

    function closeSearch() {
      if (!searchOverlay) return;
      searchOverlay.classList.remove('is-open');
      searchOverlay.setAttribute('aria-hidden', 'true');
      searchToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    searchToggle?.addEventListener('click', openSearch);
    searchClose?.addEventListener('click', closeSearch);

    // Mobile Fullscreen Menu
    function openMenu() {
      if (!mobileFullscreen) return;
      mobileFullscreen.classList.add('is-open');
      mobileFullscreen.setAttribute('aria-hidden', 'false');
      menuToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      if (!mobileFullscreen) return;
      mobileFullscreen.classList.remove('is-open');
      mobileFullscreen.setAttribute('aria-hidden', 'true');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    menuToggle?.addEventListener('click', openMenu);
    mobileClose?.addEventListener('click', closeMenu);

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearch();
        closeMenu();
      }
    });

    // Close when clicking outside of mobile inner container
    mobileFullscreen?.addEventListener('click', (e) => {
      if (e.target === mobileFullscreen) {
        closeMenu();
      }
    });

    searchOverlay?.addEventListener('click', (e) => {
      if (e.target === searchOverlay) {
        closeSearch();
      }
    });
  }

  // Support Astro View Transitions and initial load
  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
