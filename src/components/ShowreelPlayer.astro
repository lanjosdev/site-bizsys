---
interface Props {
  videoId?: string;
  title?: string;
  variant?: 'hero' | 'inline';
  fetchPriority?: 'high' | 'auto';
}

const {
  videoId = 'IfXxwk2Nt3k',
  title = 'BIZSYS - Showreel',
  variant = 'hero',
  fetchPriority = 'auto',
} = Astro.props;
---

<div
  class:list={['showreel-player', `is-${variant}`]}
  data-yt-facade={videoId}
  data-yt-title={title}
>
  <picture class="showreel-picture">
    <source
      type="image/avif"
      srcset="/images/hero/showreel-poster-640.avif 640w, /images/hero/showreel-poster-800.avif 800w, /images/hero/showreel-poster-1280.avif 1280w"
      sizes="(max-width: 767px) 100vw, 1400px"
    />
    <source
      type="image/webp"
      srcset="/images/hero/showreel-poster-640.webp 640w, /images/hero/showreel-poster-800.webp 800w, /images/hero/showreel-poster-1280.webp 1280w"
      sizes="(max-width: 767px) 100vw, 1400px"
    />
    <img
      src="/images/hero/showreel-poster-1280.jpg"
      alt={title}
      width="1280"
      height="720"
      class="showreel-poster"
      loading="eager"
      decoding={variant === 'hero' ? 'sync' : 'async'}
      fetchpriority={fetchPriority}
    />
  </picture>

  <div class="showreel-scrim" aria-hidden="true"></div>

  <button
    type="button"
    class:list={['showreel-play-btn', `is-${variant}`]}
    aria-label={`Assistir Showreel — ${title}`}
  >
    <span class="play-icon-circle" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="6 4 20 12 6 20 6 4"></polygon>
      </svg>
    </span>
    <span class="play-label">Assistir Showreel</span>
  </button>
</div>

<style>
  .showreel-player {
    position: relative;
    width: 100%;
    height: 100%;
    background-color: #0b0b0b;
    overflow: hidden;
  }

  .showreel-player.is-hero {
    position: relative;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - var(--header-height) - 96px);
    height: auto;
  }

  .showreel-player.is-inline {
    position: absolute;
    inset: 0;
  }

  .showreel-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .showreel-poster {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .showreel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(0, 0, 0, 0.08) 45%,
      rgba(0, 0, 0, 0.45) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .showreel-play-btn {
    position: absolute;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 8px 18px 8px 10px;
    border-radius: 999px;
    background-color: rgba(12, 12, 12, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.28);
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(8px);
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .showreel-play-btn.is-hero {
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
  }

  .showreel-play-btn.is-hero:hover {
    background-color: rgba(24, 24, 24, 0.96);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateX(-50%) translateY(-2px);
  }

  .showreel-play-btn.is-inline {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .showreel-play-btn.is-inline:hover {
    background-color: rgba(24, 24, 24, 0.96);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translate(-50%, -50%) scale(1.03);
  }

  .play-icon-circle {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background-color: #ffffff;
    color: #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px;
    flex-shrink: 0;
  }

  .showreel-player :global(.showreel-iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    z-index: 4;
  }

  @media (max-width: 767px) {
    .showreel-player.is-hero {
      max-height: none;
    }

    .showreel-play-btn.is-hero {
      bottom: 12px;
      padding: 6px 14px 6px 8px;
      font-size: 11px;
    }

    .play-icon-circle {
      width: 26px;
      height: 26px;
    }
  }
</style>

<script>
  function setupShowreelPlayers() {
    document.querySelectorAll<HTMLElement>('[data-yt-facade]').forEach((container) => {
      if (container.dataset.bound === '1') return;
      container.dataset.bound = '1';

      const playBtn = container.querySelector<HTMLButtonElement>('.showreel-play-btn');
      if (!playBtn) return;

      playBtn.addEventListener('click', () => {
        const videoId = container.dataset.ytFacade;
        const videoTitle = container.dataset.ytTitle || 'BIZSYS - Showreel';
        if (!videoId) return;

        const iframe = document.createElement('iframe');
        iframe.className = 'showreel-iframe';
        iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?controls=1&rel=0&playsinline=1&enablejsapi=1&autoplay=1`;
        iframe.title = videoTitle;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;

        container.replaceChildren(iframe);
      });
    });
  }

  setupShowreelPlayers();
  document.addEventListener('astro:after-swap', setupShowreelPlayers);
</script>
