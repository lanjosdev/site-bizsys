---
interface Props {
  mediaType?: 'video' | 'carousel' | 'image';
  videoUrl?: string;
  galleryImages?: string[];
  featuredImage: string;
  title: string;
}

const {
  mediaType = 'image',
  videoUrl,
  galleryImages = [],
  featuredImage,
  title,
} = Astro.props;

// Função para extrair embed seguro do YouTube ou Vimeo
function getEmbedUrl(url?: string): string | null {
  if (!url) return null;

  // YouTube match
  const ytMatch = url.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i);
  if (ytMatch && ytMatch[1]) {
    return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}?rel=0&modestbranding=1`;
  }

  // Vimeo match
  const vimeoMatch = url.match(/vimeo\.com\/(?:video\/)?([0-9]+)/i);
  if (vimeoMatch && vimeoMatch[1]) {
    return `https://player.vimeo.com/video/${vimeoMatch[1]}?badge=0&autopause=0&player_id=0`;
  }

  return null;
}

const embedUrl = getEmbedUrl(videoUrl);
const isVideo = mediaType === 'video' && Boolean(embedUrl);
const hasGallery = galleryImages.length > 0;
---

<div class="case-media-block">
  {isVideo ? (
    <div class="video-container">
      <div class="video-aspect-ratio">
        <iframe
          src={embedUrl}
          title={`Vídeo do projeto ${title}`}
          class="video-iframe"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
    </div>
  ) : (
    <figure class="featured-media-container">
      <img
        src={featuredImage}
        alt={title}
        class="featured-media-img"
        loading="eager"
      />
    </figure>
  )}

  {hasGallery && (
    <div class="case-gallery-block" aria-label="Galeria de imagens do projeto">
      <div class="case-gallery-grid">
        {galleryImages.map((img, idx) => (
          <figure class="gallery-item">
            <img
              src={img}
              alt={`${title} - Foto ${idx + 1}`}
              class="gallery-img"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </div>
  )}
</div>

<style>
  .case-media-block {
    width: 100%;
    margin-bottom: 3.5rem;
  }

  /* Container do Vídeo 16:9 responsivo */
  .video-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    background-color: #050505;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .video-aspect-ratio {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
  }

  .video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  /* Container de Imagem Destacada */
  .featured-media-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    border-radius: 8px;
    overflow: hidden;
    background-color: #0a0a0a;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .featured-media-img {
    width: 100%;
    height: auto;
    max-height: 720px;
    object-fit: cover;
    display: block;
  }

  /* Galeria complementar */
  .case-gallery-block {
    width: 100%;
    max-width: 1200px;
    margin: 2.5rem auto 0;
  }

  .case-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .gallery-item {
    margin: 0;
    border-radius: 6px;
    overflow: hidden;
    background-color: #111111;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform var(--transition-normal, 0.3s ease), border-color var(--transition-normal, 0.3s ease);
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .gallery-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .case-media-block {
      margin-bottom: 2.5rem;
    }

    .case-gallery-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .gallery-img {
      height: 200px;
    }
  }
</style>
