---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  isTransparentHeader?: boolean;
}

const {
  title = 'Viabilizando ideias',
  description = 'Desenvolvemos soluções criativas usando nossa expertise, focando em conectar marcas a seus consumidores, gerando engajamento e proximidade.',
  image = '/images/logo.png',
  canonicalUrl,
  isTransparentHeader = true,
} = Astro.props;

const siteUrl = 'https://www.bizsys.com.br';
const fullTitle = title.includes('Bizsys') ? title : `Bizsys | ${title}`;
const pathname = Astro.url.pathname;
const canonical = canonicalUrl || `${siteUrl}${pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

// Google Tag Manager: container padrão da Bizsys com suporte a override por env var
const envGtm = import.meta.env.PUBLIC_GTM_ID;
const gtmId = envGtm !== undefined ? (envGtm === 'disabled' || envGtm === '' ? null : envGtm) : 'GTM-K53DP29';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager (carregamento nao bloqueante apos interacao/idle) -->
    {gtmId && (
      <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var loaded=false;function loadGtm(){if(loaded)return;loaded=true;var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);}['pointerdown','keydown','scroll'].forEach(function(evt){w.addEventListener(evt,loadGtm,{once:true,passive:true});});w.addEventListener('load',function(){if('requestIdleCallback' in w){w.requestIdleCallback(loadGtm,{timeout:2000});}else{setTimeout(loadGtm,1500);}},{once:true});})(window,document,'script','dataLayer','${gtmId}');`} />
    )}
    <!-- End Google Tag Manager -->

    <!-- Favicons fiéis -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- SEO Primário -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bizsys" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={imageUrl} />

    <!-- Preload da fonte principal Good Sans -->
    <link
      rel="preload"
      href="/fonts/GoodSans-Light.otf"
      as="font"
      type="font/otf"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    {gtmId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main" class="sr-only focus:not-sr-only">Pular para o conteúdo principal</a>

    <Header currentPath={pathname} isTransparent={isTransparentHeader} />

    <main id="main" class="site-main">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .site-main {
    flex: 1;
    width: 100%;
    min-height: calc(100vh - var(--header-height));
  }
</style>
