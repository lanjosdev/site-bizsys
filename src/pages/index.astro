---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURED_CASES } from '../data/wpData';

const pageTitle = 'Viabilizando ideias';
const pageDescription = 'Desenvolvemos soluções criativas usando nossa expertise, focando em conectar marcas a seus consumidores, gerando engajamento e proximidade.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={true}
>
  <div class="bizsys-home">
    <!-- 1. HERO COM VÍDEO SHOWREEL YOUTUBE (Fiel a elementor-element-916fa90) -->
    <section class="section-hero" aria-label="Apresentação Bizsys">
      <div class="video-container" aria-hidden="true">
        <iframe
          class="video-embed"
          src="https://www.youtube.com/embed/IfXxwk2Nt3k?controls=0&rel=0&playsinline=1&enablejsapi=1&autoplay=1&mute=1&loop=1&playlist=IfXxwk2Nt3k&origin=https%3A%2F%2Fwww.bizsys.com.br"
          title="BIZSYS - Showreel"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          tabindex="-1"
        ></iframe>
      </div>
      <div class="hero-overlay"></div>

      <!-- Spacer de 600px exato ao baseline (elementor-element-efbf05b) -->
      <div class="hero-spacer"></div>

      <!-- Título de acessibilidade / SEO fiel ao baseline (elementor-element-f72d50e) -->
      <h1 class="sr-only">Tecnologia e Criatividade - Bizsys</h1>
    </section>

    <!-- 2. MANIFESTO BIZSYS (Fiel a elementor-element-0eb248f) -->
    <section class="section-manifesto" aria-label="Manifesto">
      <div class="container manifesto-container">
        <p class="manifesto-text">
          Bizsys é uma produtora sediada em São Paulo, que há mais de<br class="br-desktop" />
          15 anos projeta experiências que unem marcas e público através<br class="br-desktop" />
          da criatividade, tecnologia, engenharia de produto e projetos especiais.
        </p>
      </div>
    </section>

    <!-- 3. SLIDER FULL-WIDTH FADE DE CASES (Fiel a elementor-element-df82456 / Swiper Fade) -->
    <section class="section-carousel" aria-label="Cases em Destaque">
      <div class="carousel-container">
        <div id="cases-carousel" class="cases-carousel" role="region" aria-roledescription="carousel" aria-label="Galeria de Cases">
          {FEATURED_CASES.map((item, index) => (
            <div
              class:list={['carousel-slide', { 'is-active': index === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} de ${FEATURED_CASES.length}`}
              data-slide-index={index}
            >
              <a href={item.link} class="slide-link">
                <figure class="slide-figure">
                  <div class="slide-image-wrap">
                    <img
                      src={item.image}
                      alt={item.title}
                      width="1120"
                      height="630"
                      class="slide-image"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </div>
                  <figcaption class="slide-caption">
                    {item.title} - {item.client}
                  </figcaption>
                </figure>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. NUVEM DE CATEGORIAS GIGANTE 72px (Fiel a elementor-element-a2e2c71) -->
    <section class="section-categories" aria-label="Categorias de Atuação">
      <div class="container categories-container">
        <div class="categories-text-wrap">
          <a class="cat-link is-white" href="/categoria/ooh">OOH</a>
          <a class="cat-link is-gray" href="/categoria/webapp">Web App</a>
          <a class="cat-link is-white" href="/categoria/lives">Lives</a>
          <a class="cat-link is-gray" href="/categoria/ar">AR</a>
          <a class="cat-link is-white" href="/categoria/sensor-de-movimento">Sensor de Movimento</a>
          <a class="cat-link is-gray" href="/categoria/cenografia">Cenografia</a>
          <a class="cat-link is-white" href="/categoria/ia">IA</a>
          <a class="cat-link is-gray" href="/categoria/player-de-audio">Player de Áudio</a>
          <a class="cat-link is-white" href="/categoria/led">LED</a>
          <a class="cat-link is-gray" href="/categoria/impressao-lenticular">Impressão Lenticular</a>
          <a class="cat-link is-white" href="/categoria/aromatizador">Aromatizador</a>
          <a class="cat-link is-gray" href="/categoria/projetos-especiais">Projetos Especiais</a>
          <a class="cat-link is-white" href="/categoria/produto">Produto</a>
          <a class="cat-link is-gray" href="/categoria/sampling">Sampling</a>
        </div>
      </div>
    </section>

    <!-- 5. BANNER DE PRÊMIOS 60px (Fiel a elementor-element-a8576c5) -->
    <section class="section-awards" aria-label="Premiações">
      <div class="container awards-container">
        <p class="awards-title">
          Projetos reconhecidos com<br />
          60 Prêmios de excelência.<br />
          <a class="awards-link premiosLink animated-link" href="/premios">Cases Premiados →</a>
        </p>
      </div>
    </section>

    <!-- 6. CONTATO GIGANTE 72px (Fiel a elementor-element-271dd59) -->
    <section class="section-contact-callout" aria-label="Contato Rápido">
      <div class="container contact-callout-container">
        <a href="mailto:hello@bizsys.com.br" class="big-email-link">
          hello@bizsys.com.br
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .bizsys-home {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    overflow-x: hidden;
  }

  /* 1. HERO (elementor-element-916fa90) */
  .section-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background-color: #000000;
  }

  .video-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 100vh;
    min-width: 177.77vh; /* 16:9 aspect ratio */
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 1;
  }

  .video-embed {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
    transform: scale(1.15); /* Elimina bordas do YouTube */
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.25);
    z-index: 2;
  }

  .hero-spacer {
    height: 600px;
    width: 100%;
    position: relative;
    z-index: 3;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .section-hero {
      height: 85vh;
      min-height: 480px;
    }
    .hero-spacer {
      height: 350px;
    }
  }

  /* 2. MANIFESTO (elementor-element-0eb248f & elementor-element-6dbc75c) */
  .section-manifesto {
    background-color: #000000D9;
    padding: 60px 0 30px 0;
    position: relative;
    z-index: 10;
  }

  .manifesto-container {
    max-width: 1120px;
  }

  .manifesto-text {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 300;
    line-height: 32px;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-align: center;
    margin: 0;
  }

  .br-desktop {
    display: block;
  }

  @media (max-width: 767px) {
    .section-manifesto {
      padding: 40px 0 20px 0;
    }
    .manifesto-text {
      text-align: left;
      font-size: 16px;
      line-height: 22px;
    }
    .br-desktop {
      display: none;
    }
  }

  /* 3. CAROUSEL FADE DE CASES (elementor-element-df82456 & 5e15775) */
  .section-carousel {
    background-color: #000000;
    padding: 40px 0 20px 0;
    position: relative;
    z-index: 10;
  }

  .carousel-container {
    width: 100%;
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
  }

  .cases-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 320px;
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s ease-in-out, visibility 0.6s ease-in-out;
    pointer-events: none;
    z-index: 1;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .slide-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .slide-figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .slide-image-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #050505;
  }

  .slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .slide-caption {
    text-align: left;
    color: #656362;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 60px;
    letter-spacing: 0.02em;
    padding-top: 4px;
  }

  @media (max-width: 767px) {
    .slide-caption {
      font-size: 14px;
      line-height: 40px;
    }
  }

  /* 4. NUVEM DE CATEGORIAS 72px (elementor-element-a2e2c71 & 9ae6be3) */
  .section-categories {
    background-color: #000000;
    padding: 150px 0;
    position: relative;
    z-index: 10;
    width: 100%;
    overflow-x: hidden;
  }

  .categories-container {
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    width: 100%;
    box-sizing: border-box;
  }

  .categories-text-wrap {
    font-family: var(--font-primary);
    font-size: 72px;
    font-weight: 300;
    line-height: 80.64px;
    letter-spacing: -4.5px;
    word-spacing: 0.05em;
    text-align: left;
    word-break: normal;
    overflow-wrap: break-word;
  }

  .cat-link,
  .menu2 {
    display: inline-block;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
    margin-right: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .cat-link.is-white,
  .menu2.is-white {
    color: #ffffff;
  }

  .cat-link.is-gray,
  .menu2.is-gray {
    color: #656362;
  }

  .cat-link:hover,
  .menu2:hover {
    border-bottom: 1px solid #656362;
  }

  @media (max-width: 959px) {
    .section-categories {
      padding: 80px 0;
    }
    .categories-text-wrap {
      font-size: clamp(32px, 5.5vw, 48px);
      line-height: 1.25;
      letter-spacing: -1.5px;
    }
    .cat-link {
      margin-right: 1rem;
    }
  }

  @media (max-width: 767px) {
    .section-categories {
      padding: 50px 0;
    }
    .categories-container {
      padding-left: 16px;
      padding-right: 16px;
    }
    .categories-text-wrap {
      font-size: clamp(22px, 6.5vw, 32px);
      line-height: 1.25;
      letter-spacing: -0.5px;
      word-spacing: normal;
      word-break: break-word;
      overflow-wrap: break-word;
    }
    .cat-link {
      margin-right: 0.75rem;
      margin-bottom: 0.25rem;
    }
  }

  /* 5. BANNER DE PRÊMIOS 60px (elementor-element-a8576c5 & ed5b2c4) */
  .section-awards {
    background-color: #000000;
    background-image: url('/images/awards-bg.png');
    background-position: center bottom;
    background-repeat: no-repeat;
    background-size: cover;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 0;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .awards-container {
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 24px;
    padding-right: 24px;
    position: relative;
    z-index: 2;
  }

  .awards-title {
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 60px;
    font-weight: 300;
    line-height: 67.2px;
    letter-spacing: -4.5px;
    margin: 0;
  }

  .awards-link,
  .premiosLink {
    position: relative;
    display: inline-block;
    color: #ffffff;
    text-decoration: none;
    padding-bottom: 4px;
  }

  .awards-link::before,
  .premiosLink::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: 2px;
    left: 0;
    background-color: #ffffff;
    visibility: hidden;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.35s ease-in-out, visibility 0.35s ease-in-out;
  }

  .awards-link:hover::before,
  .premiosLink:hover::before {
    visibility: visible;
    transform: scaleX(1);
  }

  @media (max-width: 767px) {
    .section-awards {
      min-height: 70vh;
      background-position: top center;
      padding: 60px 0;
      text-align: left;
    }
    .awards-title {
      font-size: 36px;
      line-height: 44px;
      letter-spacing: -1.5px;
    }
    /* Sublinhado visível por padrão no mobile para indicar que é clicável */
    .awards-link::before,
    .premiosLink::before {
      visibility: visible;
      transform: scaleX(1);
    }
  }

  /* 6. CONTATO GIGANTE 72px (elementor-element-271dd59 & a8536e8) */
  .section-contact-callout {
    background-color: #000000;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 0 120px 0;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .contact-callout-container {
    max-width: 1120px;
  }

  .big-email-link {
    display: inline-block;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: clamp(32px, 5.5vw, 72px);
    font-weight: 300;
    line-height: 80.6px;
    letter-spacing: -2.5px;
    text-decoration: none;
    border-bottom: 2px solid #ffffff;
    padding-bottom: 8px;
    transition: opacity var(--transition-fast);
  }

  .big-email-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 767px) {
    .section-contact-callout {
      min-height: auto;
      padding: 60px 0 80px 0;
      text-align: left;
    }
    .big-email-link {
      font-size: 28px;
      line-height: 36px;
      letter-spacing: -1px;
    }
  }
</style>

<script>
  function setupCasesCarousel() {
    const carousel = document.getElementById('cases-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    const intervalTime = 5000; // 5 segundos, idêntico a elementor data-settings

    function goToSlide(index: number) {
      slides[currentIndex]?.classList.remove('is-active');
      currentIndex = (index + slides.length) % slides.length;
      slides[currentIndex]?.classList.add('is-active');
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function startAutoplay() {
      if (autoplayTimer) clearInterval(autoplayTimer);
      autoplayTimer = setInterval(nextSlide, intervalTime);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Pause on hover (fiel a "pause_on_hover: yes" do Elementor)
    carousel.addEventListener('mouseenter', stopAutoplay);
    carousel.addEventListener('mouseleave', startAutoplay);

    // Suporte a swipe simples no mobile
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      stopAutoplay();
    }, { passive: true });

    carousel.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) nextSlide();
        else goToSlide(currentIndex - 1);
      }
      startAutoplay();
    }, { passive: true });

    startAutoplay();
  }

  setupCasesCarousel();
  document.addEventListener('astro:after-swap', setupCasesCarousel);
</script>
