---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Projetos';
const pageDescription = 'Digital, Cenografia, Produto. A Bizsys trabalha com foco nessas três frentes de desenvolvimento.';

// Carrega os 15 cases com cobertura e páginas dedicadas
const priorityPosts = await getCollection('posts');

// 19 Últimos Cases fiéis ao Elementor original
const ultimosCases = [
  { caption: "Mega McFritas - McDonald's", image: '/images/projetos/megamcfritas-1536x864.png' },
  { caption: 'Giga Gloob - Globo', image: '/images/projetos/gloob1-1536x864.png' },
  { caption: '#UberNaAvenida', image: '/images/projetos/uber6-1536x864.png' },
  { caption: 'The GPP Flare Experince', image: '/images/projetos/gpp-1-1536x864.png' },
  { caption: 'Experiência Keep Walking - Johnnie Walker', image: '/images/projetos/experiencia-johnnie-walker-1-1536x864.png' },
  { caption: 'Bonde da Curtição - Engov', image: '/images/projetos/engov-1536x864.png' },
  { caption: 'Energia Verde Heineken', image: '/images/projetos/jeineken-energia-limpa-1536x864.jpg' },
  { caption: 'La Casa De Papel Parte 5 - Netflix', image: '/images/projetos/lacasadepapel-1536x864.png' },
  { caption: 'Verdades Secretas II - Globoplay', image: '/images/projetos/verdadessecretas-1536x864.png' },
  { caption: 'Maradona: Conquista De Um Sonho Amazon Prime Video', image: '/images/projetos/maradona-1-1-1536x864.png' },
  { caption: 'Família Addams 2: Pé Na Estrada -Universal Pictures', image: '/images/projetos/familiaaddams2-1536x864.png' },
  { caption: 'O Esquadrão Suicida - HBO Max', image: '/images/projetos/Frame-1-1536x864.png' },
  { caption: 'Lil Sugar - Hip Hop Public Health e Area 23', image: '/images/projetos/lil3-1536x864.png' },
  { caption: 'Olimpíadas 2021 - SporTV', image: '/images/projetos/olimpiadas-1536x864.png' },
  { caption: 'Voz do Fernandão - Adiddas', image: '/images/projetos/voz-do-fernandao-adidas-1536x864.png' },
  { caption: '#BatuqueChallenge - Chevrolet', image: '/images/projetos/7-1-1536x864.jpg' },
  { caption: 'Você Nunca Esteve Sozinha - Globoplay', image: '/images/projetos/Cactos-1536x864.png' },
  { caption: 'Nova Devassa', image: '/images/projetos/devassa-1536x864.png' },
  { caption: 'Cozinha Às Cegas - Maggi', image: '/images/projetos/CAC_9-1536x864.png', slug: 'cozinha-as-cegas-maggi' },
];

// 3 Colunas de Categorias fiéis ao Elementor original
const categoryColumns = [
  [
    { name: 'Lives', slug: 'lives' },
    { name: 'AR', slug: 'ar' },
    { name: 'Sensor de Movimento', slug: 'sensor-de-movimento' },
    { name: 'Sampling', slug: 'sampling' },
  ],
  [
    { name: 'Cenografia', slug: 'cenografia' },
    { name: 'Player de Áudio', slug: 'player-de-audio' },
    { name: 'LED', slug: 'led' },
    { name: 'Impressão Lenticular', slug: 'impressao-lenticular' },
    { name: 'WebApp', slug: 'webapp' },
  ],
  [
    { name: 'Aromatizador', slug: 'aromatizador' },
    { name: 'Projetos Especiais', slug: 'projetos-especiais' },
    { name: 'Produto', slug: 'produto' },
    { name: 'OOH', slug: 'ooh' },
    { name: 'IA', slug: 'ia' },
  ],
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/projetos"
>
  <div class="work-page">
    <!-- 1. HERO INSTITUCIONAL: Digital, Cenografia, Produto (108px centralizado) -->
    <section class="section-work-hero scroll-fade" aria-label="Frentes de Atuação">
      <div class="container container-hero">
        <div class="frentes-header">
          <h1 class="frente-title">Digital</h1>
          <h1 class="frente-title">Cenografia</h1>
          <h1 class="frente-title">Produto</h1>
        </div>
        <p class="frentes-desc">
          A Bizsys trabalha com foco nessas três frentes de desenvolvimento, que são compostas por especialistas em Tecnologia, Produção, Design, Eletrônica e Mecânica.
        </p>
      </div>
    </section>

    <!-- 2. ÚLTIMOS CASES (19 Projetos, 20px label cinza, hover opacity 0.75, legendas 24px) -->
    <section class="section-ultimos-cases scroll-fade" aria-label="Últimos Cases">
      <div class="container container-cases">
        <h2 class="section-tag-title">Últimos Cases</h2>
        <div class="cases-4col-grid">
          {ultimosCases.map((c) => (
            <article class="case-grid-card">
              <a href={c.slug ? `/posts/${c.slug}` : '/projetos'} class="case-card-link">
                <figure class="case-thumb-figure">
                  <div class="case-thumb-box">
                    <img
                      src={c.image}
                      alt={c.caption}
                      width="1536"
                      height="864"
                      class="case-thumb-img"
                      loading="lazy"
                    />
                  </div>
                  <figcaption class="widget-image-caption">{c.caption}</figcaption>
                </figure>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CASES EM DESTAQUE COM COBERTURA COMPLETA -->
    <section class="section-ultimos-cases section-priority-cases scroll-fade" aria-label="Cases em Destaque">
      <div class="container container-cases">
        <h2 class="section-tag-title">Cases em Destaque & Prêmios</h2>
        <div class="cases-4col-grid">
          {priorityPosts.map((p) => (
            <article class="case-grid-card">
              <a href={`/posts/${p.id}`} class="case-card-link">
                <figure class="case-thumb-figure">
                  <div class="case-thumb-box">
                    <img
                      src={p.data.featuredImage}
                      alt={p.data.title}
                      width="1536"
                      height="864"
                      class="case-thumb-img"
                      loading="lazy"
                    />
                  </div>
                  <figcaption class="widget-image-caption">
                    <span class="caption-client">{p.data.client}</span>
                    <span class="caption-title">{p.data.title}</span>
                  </figcaption>
                </figure>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. NAVEGUE POR CATEGORIA (3 Colunas em lista vertical, 32px) -->
    <section class="section-work-categories scroll-fade" aria-label="Categorias">
      <div class="container container-categories">
        <h2 class="section-tag-title cat-tag-title">Ou navegue por categoria</h2>
        <div class="categories-3col-grid">
          {categoryColumns.map((col) => (
            <ul class="cat-col-list">
              {col.map((cat) => (
                <li class="cat-col-item">
                  <a href={`/categoria/${cat.slug}`} class="cat-item-link">
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .work-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 160px;
    overflow-x: hidden;
  }

  /* --------------------------------------------------------------------------
     1. HERO SECTION (Digital, Cenografia, Produto - 108px)
     -------------------------------------------------------------------------- */
  .section-work-hero {
    padding-top: calc(var(--header-height, 73px) + 70px);
    padding-bottom: 60px;
    text-align: center;
  }

  .container-hero {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .frentes-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 40px;
  }

  .frente-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(3rem, 8vw, 108px);
    font-weight: 300;
    line-height: 1.05;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .frentes-desc {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1rem, 2vw, 24px);
    font-weight: 300;
    line-height: 1.5;
    color: #ffffff;
    max-width: 860px;
    margin: 0 auto;
    opacity: 0.9;
  }

  /* --------------------------------------------------------------------------
     2. ÚLTIMOS CASES (Grid 4 colunas fiel)
     -------------------------------------------------------------------------- */
  .section-ultimos-cases {
    padding-top: 60px;
  }

  .section-priority-cases {
    padding-top: 80px;
  }

  .container-cases {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
    box-sizing: border-box;
  }

  .section-tag-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 20px;
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 35px 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .cases-4col-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px 24px;
  }

  .case-grid-card {
    position: relative;
    width: 100%;
  }

  .case-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s ease;
  }

  .case-thumb-figure {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .case-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1536 / 864;
    overflow: hidden;
    background-color: #111111;
  }

  .case-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease, transform 0.4s ease;
  }

  /* Efeito Hover fiel ao Elementor: opacity 0.75 */
  .case-card-link:hover .case-thumb-img {
    opacity: 0.75;
    transform: scale(1.02);
  }

  .widget-image-caption {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 24px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.3;
    margin-top: 14px;
    margin-bottom: 0;
  }

  .caption-client {
    display: block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #656362;
    margin-bottom: 4px;
  }

  .caption-title {
    display: block;
    font-size: 22px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.25;
  }

  /* --------------------------------------------------------------------------
     3. NAVEGUE POR CATEGORIA (3 Colunas em lista vertical, 32px)
     -------------------------------------------------------------------------- */
  .section-work-categories {
    padding-top: 120px;
  }

  .container-categories {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 30px;
    box-sizing: border-box;
  }

  .cat-tag-title {
    margin-bottom: 40px;
  }

  .categories-3col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 40px;
  }

  .cat-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cat-col-item {
    margin: 0;
    padding: 0;
  }

  .cat-item-link {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1.25rem, 2.5vw, 32px);
    font-weight: 300;
    color: #ffffff;
    text-decoration: none;
    line-height: 1.25;
    transition: color 0.25s ease, transform 0.25s ease;
    display: inline-block;
  }

  .cat-item-link:hover {
    color: #656362;
    transform: translateX(4px);
  }

  /* --------------------------------------------------------------------------
     4. SCROLL-FADE REVEAL ANIMATION
     -------------------------------------------------------------------------- */
  .scroll-fade {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .scroll-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --------------------------------------------------------------------------
     5. RESPONSIVIDADE FIEL
     -------------------------------------------------------------------------- */
  @media (max-width: 1200px) {
    .cases-4col-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px 20px;
    }
  }

  @media (max-width: 860px) {
    .cases-4col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
    }

    .categories-3col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .widget-image-caption {
      font-size: 20px;
    }
  }

  @media (max-width: 600px) {
    .section-work-hero {
      padding-top: calc(var(--header-height, 73px) + 40px);
      padding-bottom: 40px;
    }

    .container-cases,
    .container-categories {
      padding: 0 20px;
    }

    .cases-4col-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .categories-3col-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .section-work-categories {
      padding-top: 80px;
    }
  }
</style>

<script>
  function setupScrollFade() {
    const elements = document.querySelectorAll('.scroll-fade');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupScrollFade();
  });
</script>
