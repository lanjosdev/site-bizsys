---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Projetos';
const pageDescription = 'Digital, Cenografia, Produto. A Bizsys trabalha com foco nessas três frentes de desenvolvimento.';

// 19 Últimos Cases fiéis ao Elementor original
const ultimosCases = [
  { caption: "Mega McFritas - McDonald's", image: '/images/projetos/megamcfritas-1536x864.png', slug: 'mega-mcfritas-mcdonalds' },
  { caption: 'Giga Gloob - Globo', image: '/images/projetos/gloob1-1536x864.png', slug: 'giga-gloob' },
  { caption: '#UberNaAvenida', image: '/images/projetos/uber6-1536x864.png', slug: 'ubernaavenida' },
  { caption: 'The GPP Flare Experince', image: '/images/projetos/gpp-1-1536x864.png', slug: 'the-gpp-experience' },
  { caption: 'Experiência Keep Walking - Johnnie Walker', image: '/images/projetos/experiencia-johnnie-walker-1-1536x864.png', slug: 'experiencia-keep-walking-johnnie-walker' },
  { caption: 'Bonde da Curtição - Engov', image: '/images/projetos/engov-1536x864.png', slug: 'bonde-da-curticao-engov' },
  { caption: 'Energia Verde Heineken', image: '/images/projetos/jeineken-energia-limpa-1536x864.jpg', slug: 'energia-verde-heineken' },
  { caption: 'La Casa De Papel Parte 5 - Netflix', image: '/images/projetos/lacasadepapel-1536x864.png', slug: 'la-casa-de-papel-parte-5-netflix' },
  { caption: 'Verdades Secretas II - Globoplay', image: '/images/projetos/verdadessecretas-1536x864.png', slug: 'verdades-secretas-2-globoplay' },
  { caption: 'Maradona: Conquista De Um Sonho Amazon Prime Video', image: '/images/projetos/maradona-1-1-1536x864.png', slug: 'maradona-conquista-de-um-sonho-amazon-prime-video' },
  { caption: 'Família Addams 2: Pé Na Estrada -Universal Pictures', image: '/images/projetos/familiaaddams2-1536x864.png', slug: 'familia-addams-2' },
  { caption: 'O Esquadrão Suicida - HBO Max', image: '/images/projetos/Frame-1-1536x864.png', slug: 'o-esquadrao-suicida-hbo-max' },
  { caption: 'Lil Sugar - Hip Hop Public Health e Area 23', image: '/images/projetos/lil3-1536x864.png', slug: 'lil-sugar-hip-hop-public-health-e-area23' },
  { caption: 'Olimpíadas 2021 - SporTV', image: '/images/projetos/olimpiadas-1536x864.png', slug: 'olimpiadas-toquio-2020' },
  { caption: 'Voz do Fernandão - Adiddas', image: '/images/projetos/voz-do-fernandao-adidas-1536x864.png', slug: 'voz-do-fernandao-adidas' },
  { caption: '#BatuqueChallenge - Chevrolet', image: '/images/projetos/7-1-1536x864.jpg', slug: 'batuque-challenge-chevrolet' },
  { caption: 'Você Nunca Esteve Sozinha - Globoplay', image: '/images/projetos/Cactos-1536x864.png', slug: 'cactos-voce-nunca-esteve-sozinha' },
  { caption: 'Nova Devassa', image: '/images/projetos/devassa-1536x864.png', slug: 'nova-devassa-devassa' },
  { caption: 'Cozinha Às Cegas - Maggi', image: '/images/projetos/CAC_9-1536x864.png', slug: 'cozinha-as-cegas-maggi' },
];

// 3 Colunas de Categorias fiéis ao Elementor original
const categoryColumns = [
  [
    { name: 'Lives', slug: 'lives' },
    { name: 'AR', slug: 'ar' },
    { name: 'Sensor de Movimento', slug: 'sensor-de-movimento' },
    { name: 'Sampling', slug: 'sampling' },
  ],
  [
    { name: 'Cenografia', slug: 'cenografia' },
    { name: 'Player de Áudio', slug: 'player-de-audio' },
    { name: 'LED', slug: 'led' },
    { name: 'Impressão Lenticular', slug: 'impressao-lenticular' },
    { name: 'WebApp', slug: 'webapp' },
  ],
  [
    { name: 'Aromatizador', slug: 'aromatizador' },
    { name: 'Projetos Especiais', slug: 'projetos-especiais' },
    { name: 'Produto', slug: 'produto' },
    { name: 'OOH', slug: 'ooh' },
    { name: 'IA', slug: 'ia' },
  ],
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/projetos"
>
  <div class="work-page">
    <!-- 1. HERO INSTITUCIONAL: Digital, Cenografia, Produto (108px centralizado) -->
    <section class="section-work-hero scroll-fade" aria-label="Frentes de Atuação">
      <div class="container container-hero">
        <div class="frentes-header">
          <h1 class="frente-title">Digital</h1>
          <h1 class="frente-title">Cenografia</h1>
          <h1 class="frente-title">Produto</h1>
        </div>
        <p class="frentes-desc">
          A Bizsys trabalha com foco nessas três frentes de desenvolvimento, que são compostas por especialistas em Tecnologia, Produção, Design, Eletrônica e Mecânica.
        </p>
      </div>
    </section>

    <!-- 2. ÚLTIMOS CASES (19 Projetos selecionados fiéis ao /work original) -->
    <section class="section-ultimos-cases scroll-fade" aria-label="Últimos Cases">
      <div class="container container-cases">
        <div class="cases-header-wrap">
          <h2 class="section-tag-title">Últimos Cases</h2>
          <a href="/categoria/todos" class="link-view-all">Ver todos os projetos →</a>
        </div>
        <div class="cases-4col-grid">
          {ultimosCases.map((c) => (
            <article class="case-grid-card">
              <a href={c.slug ? `/posts/${c.slug}` : '/projetos'} class="case-card-link">
                <figure class="case-thumb-figure">
                  <div class="case-thumb-box">
                    <img
                      src={c.image}
                      alt={c.caption}
                      width="1536"
                      height="864"
                      class="case-thumb-img"
                      loading="lazy"
                    />
                  </div>
                  <figcaption class="widget-image-caption">{c.caption}</figcaption>
                </figure>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. NAVEGUE POR CATEGORIA (3 Colunas em lista vertical, 32px) -->
    <section class="section-work-categories scroll-fade" aria-label="Categorias">
      <div class="container container-categories">
        <h2 class="section-tag-title cat-tag-title">Ou navegue por categoria</h2>
        <div class="categories-3col-grid">
          {categoryColumns.map((col) => (
            <ul class="cat-col-list">
              {col.map((cat) => (
                <li class="cat-col-item">
                  <a href={`/categoria/${cat.slug}`} class="cat-item-link">
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
        <div class="categories-bottom-action">
          <a href="/categoria/todos" class="btn-all-catalogue">
            Explorar Catálogo Completo de Projetos →
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .work-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 160px;
    overflow-x: hidden;
  }

  /* --------------------------------------------------------------------------
     1. HERO SECTION (Digital, Cenografia, Produto - 108px)
     -------------------------------------------------------------------------- */
  .section-work-hero {
    padding-top: calc(var(--header-height, 73px) + 70px);
    padding-bottom: 60px;
    text-align: center;
  }

  .container-hero {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .frentes-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 40px;
  }

  .frente-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(3rem, 8vw, 108px);
    font-weight: 300;
    line-height: 1.05;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .frentes-desc {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1rem, 2vw, 24px);
    font-weight: 300;
    line-height: 1.5;
    color: #888888;
    max-width: 900px;
    margin: 0 auto;
  }

  /* --------------------------------------------------------------------------
     2. ÚLTIMOS CASES (Grid de 4 colunas fiel ao Elementor)
     -------------------------------------------------------------------------- */
  .section-ultimos-cases {
    padding: 60px 0 80px;
  }

  .container-cases {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
    box-sizing: border-box;
  }

  .cases-header-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 30px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 15px;
  }

  .section-tag-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 20px;
    font-weight: 400;
    color: #656362;
    text-transform: none;
    letter-spacing: 0;
    margin: 0;
  }

  .link-view-all {
    color: #888888;
    font-size: 0.875rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: color var(--transition-normal, 0.25s ease);
  }

  .link-view-all:hover {
    color: #ffffff;
  }

  .cases-4col-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px 24px;
  }

  .case-grid-card {
    position: relative;
    width: 100%;
  }

  .case-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .case-thumb-figure {
    margin: 0;
    padding: 0;
  }

  .case-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #0d0d0d;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .case-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--transition-normal, 0.3s ease), transform var(--transition-normal, 0.3s ease);
  }

  .case-card-link:hover .case-thumb-img {
    opacity: 0.75;
    transform: scale(1.02);
  }

  .widget-image-caption {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1.125rem, 1.4vw, 24px);
    font-weight: 300;
    line-height: 1.3;
    color: #ffffff;
    margin-top: 16px;
    margin-bottom: 0;
  }

  /* --------------------------------------------------------------------------
     3. NAVEGUE POR CATEGORIA (3 Colunas em lista vertical, 32px)
     -------------------------------------------------------------------------- */
  .section-work-categories {
    padding: 80px 0 60px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .container-categories {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .cat-tag-title {
    margin-bottom: 40px;
  }

  .categories-3col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px 40px;
  }

  .cat-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cat-col-item {
    margin: 0;
  }

  .cat-item-link {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1.25rem, 2vw, 32px);
    font-weight: 300;
    color: #ffffff;
    text-decoration: none;
    line-height: 1.3;
    display: inline-block;
    transition: color var(--transition-normal, 0.25s ease), transform var(--transition-normal, 0.25s ease);
  }

  .cat-item-link:hover {
    color: #999999;
    transform: translateX(6px);
  }

  .categories-bottom-action {
    margin-top: 50px;
    text-align: center;
  }

  .btn-all-catalogue {
    display: inline-block;
    padding: 0.875rem 2.25rem;
    background-color: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 0.9375rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: all var(--transition-normal, 0.25s ease);
  }

  .btn-all-catalogue:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  /* --------------------------------------------------------------------------
     RESPONSIVIDADE
     -------------------------------------------------------------------------- */
  @media (max-width: 1200px) {
    .cases-4col-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 30px 20px;
    }
  }

  @media (max-width: 860px) {
    .cases-4col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px 16px;
    }

    .categories-3col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px 30px;
    }
  }

  @media (max-width: 560px) {
    .cases-4col-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .categories-3col-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .cases-header-wrap {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
