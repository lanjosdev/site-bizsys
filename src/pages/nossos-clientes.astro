---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CLIENTS_LIST } from '../data/wpData';

const pageTitle = 'Nossos Clientes';
const pageDescription = 'Conheça as marcas que inovam conosco. Mais de 80 clientes globais atendidos com tecnologia criativa e engenharia de produto.';

const metrics = [
  { value: '15+', label: 'Anos de Inovação' },
  { value: '60+', label: 'Prêmios Internacionais' },
  { value: '80+', label: 'Grandes Marcas Atendidas' },
  { value: '500+', label: 'Projetos Especiais Entregues' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="clients-page">
    <!-- Hero Section -->
    <section class="clients-hero">
      <div class="container clients-hero-inner">
        <span class="section-tag">PARCEIROS</span>
        <h1 class="clients-main-title">As marcas que inovam conosco.</h1>
        <p class="clients-manifesto">
          Algumas das marcas que fazem de tudo para inovar e acreditam que conversar com seu consumidor de forma inovadora é o melhor jeito de aumentar seu poder de venda.
        </p>
      </div>
    </section>

    <!-- Métricas de Impacto & Alcance -->
    <section class="metrics-section">
      <div class="container">
        <div class="metrics-grid">
          {metrics.map((m) => (
            <div class="metric-card">
              <span class="metric-value">{m.value}</span>
              <span class="metric-label">{m.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Onde estão nossos clientes -->
    <section class="reach-section">
      <div class="container reach-inner">
        <div class="reach-text">
          <span class="section-tag">ALCANCE GLOBAL</span>
          <h2 class="reach-title">Onde estão nossos clientes</h2>
          <p class="reach-description">
            Com sede em São Paulo e atuação em todo o território nacional e América Latina, a Bizsys desenvolve ativações que operam em aeroportos, shopping centers, festivais, vias públicas de grande circulação, ambientes corporativos e plataformas digitais globais.
          </p>
        </div>
        <div class="reach-features">
          <div class="reach-feature-card">
            <h3 class="feature-title">Ativações OOH e Praças Públicas</h3>
            <p class="feature-text">Interações imersivas instaladas em locais de altíssimo fluxo nas principais capitais do país.</p>
          </div>
          <div class="reach-feature-card">
            <h3 class="feature-title">Soluções Híbridas & Streaming</h3>
            <p class="feature-text">Projetos conectados com plataformas em nuvem, lives interativas e visões em tempo real.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Grid Completo de Marcas -->
    <section class="brands-section">
      <div class="container">
        <div class="brands-header">
          <h2 class="brands-title">Marcas Atendidas</h2>
          <p class="brands-subtitle">
            Algumas das empresas e agências que escolheram a Bizsys para viabilizar seus maiores desafios criativos.
          </p>
        </div>

        <div class="brands-grid">
          {CLIENTS_LIST.map((client) => (
            <div class="brand-card">
              <span class="brand-dot" aria-hidden="true">•</span>
              <span class="brand-name">{client}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="container cta-inner">
        <h2 class="cta-title">Pronto para tirar a sua ideia do papel?</h2>
        <p class="cta-text">
          Nossa equipe de engenharia e tecnologia está pronta para analisar seu briefing e construir um protótipo sob medida.
        </p>
        <a href="/contato" class="cta-button">
          Fale com a Bizsys →
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .clients-page {
    background-color: var(--color-bg);
  }

  /* Hero */
  .clients-hero {
    padding: 160px 0 80px;
    background: radial-gradient(circle at 50% 15%, #151515 0%, #000000 80%);
    border-bottom: 1px solid var(--color-border);
  }

  .clients-hero-inner {
    max-width: 960px;
  }

  .section-tag {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.15em;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .clients-main-title {
    font-size: clamp(36px, 6vw, 68px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .clients-manifesto {
    font-size: clamp(17px, 2vw, 22px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Métricas */
  .metrics-section {
    padding: 60px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: #050505;
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media (min-width: 960px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
    }
  }

  .metric-card {
    padding: 24px 20px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    text-align: center;
  }

  .metric-value {
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 300;
    color: #ffffff;
    letter-spacing: -1.5px;
    line-height: 1;
  }

  .metric-label {
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    font-weight: 300;
  }

  /* Alcance */
  .reach-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .reach-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 50px;
  }

  @media (min-width: 960px) {
    .reach-inner {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 80px;
    }
  }

  .reach-title {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .reach-description {
    font-size: 17px;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .reach-features {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .reach-feature-card {
    padding: 28px 24px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .feature-title {
    font-size: 18px;
    font-weight: 300;
    color: #ffffff;
    margin-bottom: 8px;
  }

  .feature-text {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Brands Grid */
  .brands-section {
    padding: 100px 0;
    background-color: #030303;
    border-bottom: 1px solid var(--color-border);
  }

  .brands-header {
    margin-bottom: 50px;
    max-width: 800px;
  }

  .brands-title {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .brands-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
  }

  .brands-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  @media (min-width: 640px) {
    .brands-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .brands-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
  }

  .brand-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 22px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    transition: transform var(--transition-fast), border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .brand-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.35);
    background-color: var(--color-surface-hover);
  }

  .brand-dot {
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  .brand-name {
    font-size: 15px;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* CTA */
  .cta-section {
    padding: 120px 0;
    background: radial-gradient(circle at 50% 50%, #111111 0%, #000000 80%);
    text-align: center;
  }

  .cta-inner {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .cta-title {
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 300;
    letter-spacing: -2px;
    line-height: 1.15;
    color: #ffffff;
  }

  .cta-text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .cta-button {
    margin-top: 12px;
    display: inline-block;
    padding: 16px 40px;
    background-color: #ffffff;
    color: #000000;
    font-size: 15px;
    letter-spacing: 0.05em;
    font-weight: 400;
    border-radius: 4px;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .cta-button:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .clients-hero {
      padding: 120px 0 60px;
    }
    .metrics-section,
    .reach-section,
    .brands-section,
    .cta-section {
      padding: 60px 0;
    }
  }
</style>
