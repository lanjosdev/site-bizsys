---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PREMIOS_COUNTERS, PREMIOS_CASES } from '../../data/premiosData';

const pageTitle = 'Prêmios';
const pageDescription = 'Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/premios"
>
  <div class="premios-page">
    <!-- 1. HERO INSTITUCIONAL -->
    <section class="section-premios-hero" aria-label="Hero Prêmios">
      <div class="container container-premios">
        <h1 class="premios-hero-title">Prêmios</h1>
        <p class="premios-hero-desc">
          Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.
        </p>
      </div>
    </section>

    <!-- 2. CONTADORES DE IMPACTO -->
    <section class="section-premios-counters" aria-label="Estatísticas de Premiações">
      <div class="container container-premios">
        <div class="counters-grid" id="counters-grid">
          {PREMIOS_COUNTERS.map((counter) => (
            <div class="counter-card">
              <span
                class="counter-number"
                data-target={counter.value}
                aria-label={`${counter.value} ${counter.label}`}
              >
                0
              </span>
              <span class="counter-label">{counter.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CASES SELECIONADOS (23 CASES) -->
    <section class="section-premios-cases" aria-label="Cases Selecionados">
      <div class="container container-premios">
        <h2 class="premios-section-title">Cases Selecionados</h2>
        <div class="premios-cases-grid">
          {PREMIOS_CASES.map((item) => (
            <article class="premio-case-card">
              <div class="premio-thumb-box">
                <img
                  src={item.image}
                  alt={`${item.title} - ${item.client}`}
                  width="800"
                  height="450"
                  class="premio-thumb-img"
                  loading="lazy"
                />
              </div>

              <div class="premio-card-body">
                <h3 class="premio-case-title">{item.title}</h3>
                <p class="premio-case-client">{item.client}</p>

                <div class="premio-festivals-list">
                  {item.festivals.map((fest) => (
                    <div class="premio-festival-group">
                      <div class="premio-festival-heading">
                        <span class="festival-star" aria-hidden="true">✸</span>
                        <span class="festival-name">{fest.festival}</span>
                      </div>
                      <ul class="premio-award-items">
                        {fest.items.map((award) => (
                          <li class="premio-award-item">{award}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .premios-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 120px;
  }

  .container-premios {
    max-width: 1120px;
  }

  /* 1. HERO */
  .section-premios-hero {
    padding: 160px 0 50px 0;
  }

  .premios-hero-title {
    font-family: var(--font-primary);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -3.5px;
    color: #ffffff;
    margin: 0 0 24px 0;
  }

  .premios-hero-desc {
    font-family: var(--font-primary);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 300;
    line-height: 34px;
    color: #ffffff;
    max-width: 920px;
  }

  /* 2. CONTADORES */
  .section-premios-counters {
    padding: 48px 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .counters-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 20px;
  }

  @media (min-width: 768px) {
    .counters-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .counter-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .counter-number {
    font-family: var(--font-primary);
    font-size: clamp(52px, 6vw, 76px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 8px;
    font-variant-numeric: tabular-nums;
  }

  .counter-label {
    font-family: var(--font-primary);
    font-size: 13px;
    letter-spacing: 0.08em;
    font-weight: 400;
    color: #888888;
    text-transform: uppercase;
  }

  /* 3. CASES SELECIONADOS */
  .section-premios-cases {
    padding-top: 70px;
  }

  .premios-section-title {
    font-family: var(--font-primary);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 48px;
  }

  .premios-cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px 32px;
  }

  @media (min-width: 640px) {
    .premios-cases-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px 28px;
    }
  }

  @media (min-width: 1024px) {
    .premios-cases-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 56px 32px;
    }
  }

  .premio-case-card {
    display: flex;
    flex-direction: column;
    background-color: transparent;
  }

  .premio-thumb-box {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #080808;
    border: 1px solid var(--color-border);
  }

  .premio-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .premio-case-card:hover .premio-thumb-img {
    transform: scale(1.04);
  }

  .premio-card-body {
    display: flex;
    flex-direction: column;
    padding-top: 16px;
  }

  .premio-case-title {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.3;
    margin: 0;
  }

  .premio-case-client {
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 300;
    color: #888888;
    margin: 4px 0 16px 0;
  }

  /* Premiações e medalhas */
  .premio-festivals-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
  }

  .premio-festival-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .premio-festival-heading {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 500;
    color: #e0e0e0;
    letter-spacing: 0.02em;
  }

  .festival-star {
    color: #ffffff;
    font-size: 11px;
    flex-shrink: 0;
  }

  .premio-award-items {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .premio-award-item {
    font-family: var(--font-primary);
    font-size: 12px;
    line-height: 1.5;
    color: #999999;
    position: relative;
  }

  .premio-award-item::before {
    content: '–';
    position: absolute;
    left: -12px;
    color: #666666;
  }

  @media (max-width: 767px) {
    .section-premios-hero {
      padding: 120px 0 36px 0;
    }
  }
</style>

<script>
  function setupCounters() {
    const counterElements = document.querySelectorAll<HTMLElement>('.counter-number');
    if (!counterElements.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            obs.disconnect(); // Animate all counters together once visible
            animateCounters(counterElements);
          }
        });
      },
      { threshold: 0.2 }
    );

    const container = document.getElementById('counters-grid');
    if (container) {
      observer.observe(container);
    } else {
      counterElements.forEach((el) => observer.observe(el));
    }
  }

  function animateCounters(elements: NodeListOf<HTMLElement>) {
    const duration = 1800; // ms
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Smooth cubic ease out
      const easeOut = 1 - Math.pow(1 - progress, 3);

      elements.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const current = Math.round(target * easeOut);
        el.textContent = current.toString();
      });

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        elements.forEach((el) => {
          el.textContent = el.getAttribute('data-target') || '0';
        });
      }
    }

    requestAnimationFrame(update);
  }

  setupCounters();
  document.addEventListener('astro:after-swap', setupCounters);
</script>
