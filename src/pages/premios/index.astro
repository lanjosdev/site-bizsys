---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PREMIOS_COUNTERS, PREMIOS_CASES } from '../../data/premiosData';

const pageTitle = 'Prêmios';
const pageDescription = 'Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/premios"
>
  <div class="premios-page">
    <!-- 1. HERO INSTITUCIONAL (108px centralizado) -->
    <section class="section-premios-hero scroll-fade" aria-label="Hero Prêmios">
      <div class="container container-premios">
        <h1 class="premios-hero-title">Prêmios</h1>
        <p class="premios-hero-desc">
          Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.
        </p>
      </div>
    </section>

    <!-- 2. CONTADORES DE IMPACTO (Números 108px centralizados) -->
    <section class="section-premios-counters scroll-fade" aria-label="Estatísticas de Premiações">
      <div class="container container-premios">
        <div class="counters-grid" id="counters-grid">
          {PREMIOS_COUNTERS.map((counter) => (
            <div class="counter-card">
              <span
                class="counter-number"
                data-target={counter.value}
                aria-label={`${counter.value} ${counter.label}`}
              >
                0
              </span>
              <span class="counter-label">{counter.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CASES SELECIONADOS (23 Cases, Efeito Grayscale -> Cor no Hover) -->
    <section class="section-premios-cases" aria-label="Cases Selecionados">
      <div class="container container-premios">
        <h2 class="premios-section-title scroll-fade">Cases Selecionados</h2>
        <div class="premios-cases-grid">
          {PREMIOS_CASES.map((item) => {
            const hasPost = Boolean(item.slug);
            const CardWrapper = hasPost ? 'a' : 'div';
            const wrapperProps = hasPost
              ? { href: `/posts/${item.slug}`, class: 'premio-card-link-wrapper' }
              : { class: 'premio-card-static-wrapper' };

            return (
              <article class="premio-case-card scroll-fade">
                <CardWrapper {...wrapperProps}>
                  <figure class="premio-figure">
                    <div class="premio-thumb-box">
                      <img
                        src={item.image}
                        alt={`${item.title} - ${item.client}`}
                        width="800"
                        height="512"
                        class="premio-thumb-img"
                        loading="lazy"
                      />
                    </div>
                    <figcaption class="widget-image-caption">
                      {item.title}
                      {hasPost && <span class="case-detail-indicator" aria-hidden="true">→</span>}
                    </figcaption>
                  </figure>
                </CardWrapper>

                <div class="premio-card-body">
                  <p class="premio-case-client">{item.client}</p>

                  <div class="premio-awards-text">
                    {item.festivals.map((fest) => (
                      <div class="premio-fest-block">
                        <p class="fest-title">✸{fest.festival}</p>
                        {fest.items.map((aw) => (
                          <p class="fest-award-item">{aw}</p>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .premios-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 160px;
    overflow-x: hidden;
  }

  .container-premios {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* --------------------------------------------------------------------------
     1. HERO SECTION (108px font-weight 300 centralizado)
     -------------------------------------------------------------------------- */
  .section-premios-hero {
    padding-top: calc(var(--header-height, 73px) + 70px);
    padding-bottom: 60px;
    text-align: center;
  }

  .premios-hero-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(3rem, 8vw, 108px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 auto 30px;
    letter-spacing: -0.02em;
  }

  .premios-hero-desc {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1rem, 2vw, 24px);
    font-weight: 300;
    line-height: 1.5;
    color: #ffffff;
    max-width: 900px;
    margin: 0 auto;
    opacity: 0.9;
  }

  /* --------------------------------------------------------------------------
     2. CONTADORES (108px centralizado)
     -------------------------------------------------------------------------- */
  .section-premios-counters {
    padding: 40px 0 100px;
  }

  .counters-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
  }

  .counter-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .counter-number {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(3.5rem, 8vw, 108px);
    font-weight: 300;
    line-height: 1;
    color: #ffffff;
    margin-bottom: 16px;
    font-variant-numeric: tabular-nums;
  }

  .counter-label {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1rem, 1.8vw, 24px);
    font-weight: 300;
    color: #ffffff;
    line-height: 1.3;
    opacity: 0.85;
  }

  /* --------------------------------------------------------------------------
     3. CASES SELECIONADOS (Grid 3 colunas, Grayscale -> Cor no hover)
     -------------------------------------------------------------------------- */
  .section-premios-cases {
    padding-top: 40px;
  }

  .premios-section-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 20px;
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 35px 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .premios-cases-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 30px;
  }

  .premio-case-card {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .premio-card-link-wrapper {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .premio-card-static-wrapper {
    display: block;
    color: inherit;
  }

  .premio-figure {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .premio-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 800 / 512;
    background-color: #111111;
    overflow: hidden;
  }

  .premio-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%);
    transition: filter 0.4s ease, transform 0.4s ease;
  }

  .premio-case-card:hover .premio-thumb-img {
    filter: grayscale(0%);
    transform: scale(1.02);
  }

  .widget-image-caption {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 24px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.3;
    margin-top: 14px;
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.2s ease;
  }

  .premio-card-link-wrapper:hover .widget-image-caption {
    color: #cccccc;
  }

  .case-detail-indicator {
    font-size: 1.125rem;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s ease;
  }

  .premio-case-card:hover .case-detail-indicator {
    opacity: 1;
    transform: translateX(0);
  }

  .premio-card-body {
    display: flex;
    flex-direction: column;
  }

  .premio-case-client {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 14px;
    font-weight: 300;
    color: #656362;
    margin: 0 0 16px 0;
    line-height: 1.4;
  }

  .premio-awards-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .premio-fest-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fest-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 14px;
    font-weight: 300;
    color: #656362;
    margin: 0;
    line-height: 1.4;
  }

  .fest-award-item {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 14px;
    font-weight: 300;
    color: #656362;
    margin: 0;
    line-height: 1.4;
  }

  /* --------------------------------------------------------------------------
     4. SCROLL-FADE REVEAL ANIMATION
     -------------------------------------------------------------------------- */
  .scroll-fade {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .scroll-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* --------------------------------------------------------------------------
     5. RESPONSIVIDADE FIEL
     -------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .counters-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px 20px;
    }

    .premios-cases-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px 20px;
    }
  }

  @media (max-width: 640px) {
    .section-premios-hero {
      padding-top: calc(var(--header-height, 73px) + 40px);
      padding-bottom: 40px;
    }

    .counters-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .premios-cases-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .widget-image-caption {
      font-size: 20px;
    }
  }
</style>

<script>
  // Contadores animados com IntersectionObserver
  function setupCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter-number');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const targetEl = entry.target as HTMLElement;
            const targetVal = parseInt(targetEl.getAttribute('data-target') || '0', 10);
            animateCounter(targetEl, targetVal);
            observer.unobserve(targetEl);
          }
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((el) => observer.observe(el));
  }

  function animateCounter(el: HTMLElement, target: number) {
    const duration = 1800; // ms
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      // Easing out cubic
      const ease = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(ease * target);
      el.textContent = current.toString();

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        el.textContent = target.toString();
      }
    }

    requestAnimationFrame(update);
  }

  // Scroll reveal animation
  function setupScrollFade() {
    const elements = document.querySelectorAll('.scroll-fade');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    elements.forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', () => {
    setupCounters();
    setupScrollFade();
  });
</script>
