---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PREMIOS_COUNTERS, PREMIOS_CASES } from '../../data/premiosData';

const pageTitle = 'Prêmios';
const pageDescription = 'Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/premios"
>
  <div class="premios-page">
    <!-- 1. HERO INSTITUCIONAL (108px centralizado) -->
    <section class="section-premios-hero scroll-fade" aria-label="Hero Prêmios">
      <div class="container container-premios">
        <h1 class="premios-hero-title">Prêmios</h1>
        <p class="premios-hero-desc">
          Cannes Lions, Clio Awards, Wave Festival e outros já reconheceram a inovação, criatividade, tecnologia e produção da Bizsys com 60 prêmios em diversas categorias.
        </p>
      </div>
    </section>

    <!-- 2. CONTADORES DE IMPACTO (Números 108px centralizados) -->
    <section class="section-premios-counters scroll-fade" aria-label="Estatísticas de Premiações">
      <div class="container container-premios">
        <div class="counters-grid" id="counters-grid">
          {PREMIOS_COUNTERS.map((counter) => (
            <div class="counter-card">
              <span
                class="counter-number"
                data-target={counter.value}
                aria-label={`${counter.value} ${counter.label}`}
              >
                0
              </span>
              <span class="counter-label">{counter.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. CASES SELECIONADOS (23 Cases, Efeito Grayscale -> Cor no Hover) -->
    <section class="section-premios-cases" aria-label="Cases Selecionados">
      <div class="container container-premios">
        <h2 class="premios-section-title scroll-fade">Cases Selecionados</h2>
        <div class="premios-cases-grid">
          {PREMIOS_CASES.map((item) => (
            <article class="premio-case-card scroll-fade">
              <figure class="premio-figure">
                <div class="premio-thumb-box">
                  <img
                    src={item.image}
                    alt={`${item.title} - ${item.client}`}
                    width="800"
                    height="512"
                    class="premio-thumb-img"
                    loading="lazy"
                  />
                </div>
                <figcaption class="widget-image-caption">{item.title}</figcaption>
              </figure>

              <div class="premio-card-body">
                <p class="premio-case-client">{item.client}</p>

                <div class="premio-awards-text">
                  {item.festivals.map((fest) => (
                    <div class="premio-fest-block">
                      <p class="fest-title">✸{fest.festival}</p>
                      {fest.items.map((aw) => (
                        <p class="fest-award-item">{aw}</p>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .premios-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 160px;
    overflow-x: hidden;
  }

  .container-premios {
    max-width: 1140px;
  }

  /* Animações nativas de Scroll (fiel a animated-slow fadeIn do Elementor) */
  .scroll-fade {
    opacity: 0;
    transition: opacity 1.8s cubic-bezier(0.25, 0.1, 0.25, 1);
    will-change: opacity;
  }

  .scroll-fade.is-visible {
    opacity: 1;
  }

  /* 1. HERO INSTITUCIONAL */
  .section-premios-hero {
    padding: 160px 0 20px 0;
  }

  .premios-hero-title {
    font-family: var(--font-primary);
    font-size: 108px;
    font-weight: 300;
    line-height: 120.96px;
    letter-spacing: 1.4px;
    color: #ffffff;
    text-align: center;
    margin: 0;
  }

  .premios-hero-desc {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 300;
    line-height: 1.5;
    color: #ffffff;
    text-align: left;
    max-width: 900px;
    margin: 30px auto 0 auto;
  }

  /* 2. CONTADORES DE IMPACTO */
  .section-premios-counters {
    padding: 60px 0 40px 0;
  }

  .counters-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px 20px;
    text-align: center;
  }

  @media (min-width: 768px) {
    .counters-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }

  .counter-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .counter-number {
    font-family: var(--font-primary);
    font-size: 108px;
    font-weight: 300;
    line-height: 120.96px;
    color: #ffffff;
    text-align: center;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .counter-label {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 300;
    color: #656362;
    text-align: center;
    margin-top: 10px;
  }

  /* 3. CASES SELECIONADOS */
  .section-premios-cases {
    padding-top: 20px;
  }

  .premios-section-title {
    font-family: var(--font-primary);
    font-size: 40px;
    font-weight: 300;
    line-height: 45px;
    color: #ffffff;
    text-align: center;
    padding: 70px 0 50px 0;
    margin: 0;
  }

  .premios-cases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 50px 32px;
  }

  @media (min-width: 640px) {
    .premios-cases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .premios-cases-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 60px 32px;
    }
  }

  .premio-case-card {
    display: flex;
    flex-direction: column;
  }

  .premio-figure {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .premio-thumb-box {
    width: 100%;
    height: 256px;
    overflow: hidden;
    background-color: #080808;
  }

  /* EFEITO VISUAL ASSINATURA ELEMENTOR: Grayscale nativo -> Full color no hover */
  .premio-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: brightness(100%) contrast(100%) saturate(0%) blur(0px) hue-rotate(0deg);
    transition: filter 0.5s ease;
  }

  .premio-case-card:hover .premio-thumb-img {
    filter: brightness(100%) contrast(100%) saturate(100%) blur(0px) hue-rotate(0deg);
  }

  /* Título do Case 32px Good Sans */
  .widget-image-caption {
    font-family: var(--font-primary);
    font-size: 32px;
    font-weight: 300;
    line-height: 39.84px;
    color: #ffffff;
    text-align: left;
    margin-top: 10px;
  }

  .premio-card-body {
    display: flex;
    flex-direction: column;
  }

  /* Cliente 32px cinza (#656362) */
  .premio-case-client {
    font-family: var(--font-primary);
    font-size: 32px;
    font-weight: 300;
    line-height: 1.2;
    color: #656362;
    text-align: left;
    margin: 2px 0 16px 0;
  }

  /* Lista de Prêmios 16px branca com quebras originais */
  .premio-awards-text {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 19.92px;
    color: #ffffff;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .premio-fest-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .fest-title {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.35;
    color: #ffffff;
    margin: 0;
  }

  .fest-award-item {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.35;
    color: #ffffff;
    margin: 0;
  }

  /* RESPONSIVIDADE MOBILE (< 768px) */
  @media (max-width: 767px) {
    .section-premios-hero {
      padding: 120px 0 20px 0;
    }

    .premios-hero-title {
      font-size: 56px;
      line-height: 62.72px;
      letter-spacing: -2.5px;
    }

    .premios-hero-desc {
      font-size: 16px;
      line-height: 22px;
      margin: 20px 0 0 0;
    }

    .counter-number {
      font-size: 56px;
      line-height: 64px;
    }

    .counter-label {
      font-size: 16px;
    }

    .premios-section-title {
      font-size: 32px;
      padding: 50px 0 30px 0;
    }

    .premio-thumb-box {
      height: 200px;
    }

    .widget-image-caption {
      font-size: 24px;
      line-height: 30px;
    }

    .premio-case-client {
      font-size: 24px;
      line-height: 27px;
    }
  }
</style>

<script>
  // 1. Animação de Scroll Fade-In (Elementor animated-slow)
  function setupScrollAnimations() {
    const elements = document.querySelectorAll('.scroll-fade');
    if (!elements.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    elements.forEach((el) => observer.observe(el));
  }

  // 2. Animação dos Contadores Numéricos
  function setupCounters() {
    const counterElements = document.querySelectorAll<HTMLElement>('.counter-number');
    if (!counterElements.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            obs.disconnect();
            animateCounters(counterElements);
          }
        });
      },
      { threshold: 0.2 }
    );

    const container = document.getElementById('counters-grid');
    if (container) {
      observer.observe(container);
    } else {
      counterElements.forEach((el) => observer.observe(el));
    }
  }

  function animateCounters(elements: NodeListOf<HTMLElement>) {
    const duration = 1800; // ms
    const startTime = performance.now();

    function update(now: number) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easeOut = 1 - Math.pow(1 - progress, 3);

      elements.forEach((el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const current = Math.round(target * easeOut);
        el.textContent = current.toString();
      });

      if (progress < 1) {
        requestAnimationFrame(update);
      } else {
        elements.forEach((el) => {
          el.textContent = el.getAttribute('data-target') || '0';
        });
      }
    }

    requestAnimationFrame(update);
  }

  setupScrollAnimations();
  setupCounters();
  document.addEventListener('astro:after-swap', () => {
    setupScrollAnimations();
    setupCounters();
  });
</script>
