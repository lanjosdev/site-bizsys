---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');

// Filtrar apenas artigos da categoria 'news' e ordenar por data decrescente
const newsPosts = allPosts
  .filter((p) => p.data.categories.includes('news'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const pageTitle = 'News & Imprensa — Bizsys';
const pageDescription = 'Acompanhe novidades, coberturas da imprensa, lançamentos e inovações da Bizsys no mercado criativo e de tecnologia.';

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
}

const itemsPerPage = 16;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  canonicalUrl="https://www.bizsys.com.br/news"
>
  <div class="news-page">
    <div class="container container-news">
      <!-- Navegação Superior / Breadcrumb -->
      <nav class="top-breadcrumb" aria-label="Navegação estrutural">
        <a href="/" class="back-link">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Página Inicial</span>
        </a>
      </nav>

      <!-- Hero Editorial -->
      <header class="news-hero">
        <div class="news-meta-header">
          <span class="news-tag-label">Imprensa & Novidades</span>
          <span class="news-counter-pill">
            {newsPosts.length} {newsPosts.length === 1 ? 'artigo' : 'artigos'}
          </span>
        </div>
        <h1 class="news-hero-title">News</h1>
        <p class="news-hero-desc">
          Novidades, lançamentos, clipping de mídia e a cobertura de projetos e inovações da Bizsys no mercado criativo e de tecnologia.
        </p>
      </header>

      <!-- Grid Editorial de Notícias -->
      <section class="news-section" aria-label="Notícias e Clipping da Bizsys">
        {newsPosts.length > 0 ? (
          <>
            <div class="news-4col-grid" id="news-posts-grid">
              {newsPosts.map((post, index) => {
                const isHidden = index >= itemsPerPage;
                return (
                  <article class={`news-grid-card ${isHidden ? 'is-paged-hidden' : ''}`} data-index={index}>
                    <a href={`/posts/${post.id}`} class="news-card-link">
                      <figure class="news-thumb-figure">
                        <div class="news-thumb-box">
                          <img
                            src={post.data.featuredImage}
                            alt={post.data.title}
                            width="1536"
                            height="864"
                            class="news-thumb-img"
                            loading={index < 8 ? 'eager' : 'lazy'}
                          />
                          {post.data.date && (
                            <span class="news-date-badge">{formatDate(post.data.date)}</span>
                          )}
                        </div>
                        <figcaption class="widget-image-caption">
                          <span class="caption-client">{post.data.client || 'Bizsys'}</span>
                          <h2 class="caption-title">{post.data.title}</h2>
                          {post.data.excerpt && (
                            <p class="caption-excerpt">{post.data.excerpt}</p>
                          )}
                        </figcaption>
                      </figure>
                    </a>
                  </article>
                );
              })}
            </div>

            {newsPosts.length > itemsPerPage && (
              <div class="load-more-wrap">
                <button
                  type="button"
                  id="btn-load-more"
                  class="btn-load-more"
                  data-total={newsPosts.length}
                  data-page-size={itemsPerPage}
                  data-loaded={itemsPerPage}
                  aria-label="Carregar mais notícias"
                >
                  <span class="btn-text">Carregar mais notícias</span>
                  <span class="btn-badge" id="remaining-count">({newsPosts.length - itemsPerPage} restantes)</span>
                  <span class="btn-icon" aria-hidden="true">↓</span>
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="empty-news-card">
            <div class="empty-icon" aria-hidden="true">📰</div>
            <h2 class="empty-title">Novos artigos em breve</h2>
            <p class="empty-desc">
              Estamos atualizando nossa sala de imprensa. Entre em contato para solicitações de mídia e releases.
            </p>
            <div class="empty-actions">
              <a href="/contato" class="btn-empty-contact">Fale Conosco</a>
              <a href="/" class="btn-empty-back">Voltar para a Home</a>
            </div>
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function setupNewsPagination() {
    const btn = document.getElementById('btn-load-more');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const pageSize = parseInt(btn.getAttribute('data-page-size') || '16', 10);
      let loaded = parseInt(btn.getAttribute('data-loaded') || '16', 10);
      const total = parseInt(btn.getAttribute('data-total') || '0', 10);

      const hiddenItems = document.querySelectorAll('.news-grid-card.is-paged-hidden');
      const toShow = Array.from(hiddenItems).slice(0, pageSize);

      toShow.forEach((el) => {
        el.classList.remove('is-paged-hidden');
      });

      loaded += toShow.length;
      btn.setAttribute('data-loaded', String(loaded));

      const remaining = total - loaded;
      const countSpan = document.getElementById('remaining-count');
      if (countSpan) {
        countSpan.textContent = `(${remaining} restantes)`;
      }

      if (remaining <= 0) {
        btn.parentElement?.remove();
      }
    });
  }

  setupNewsPagination();
  document.addEventListener('astro:page-load', setupNewsPagination);
</script>

<style>
  .news-page {
    background-color: #000000;
    color: #ffffff;
    min-height: 100vh;
    padding-top: calc(var(--header-height, 73px) + 2rem);
    padding-bottom: 6rem;
  }

  .container-news {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Breadcrumb */
  .top-breadcrumb {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #888888;
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--transition-normal, 0.25s ease);
  }

  .back-link:hover {
    color: #ffffff;
  }

  .back-arrow {
    font-size: 1.125rem;
    transition: transform var(--transition-normal, 0.25s ease);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  /* Hero Editorial */
  .news-hero {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .news-meta-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .news-tag-label {
    display: inline-block;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
  }

  .news-counter-pill {
    display: inline-block;
    font-size: 0.75rem;
    color: #a0a0a0;
    background-color: #161616;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
  }

  .news-hero-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .news-hero-desc {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    color: #9e9e9e;
    max-width: 760px;
    line-height: 1.6;
    margin: 0;
  }

  /* Grid 4 Colunas */
  .news-4col-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem 1.5rem;
  }

  .news-grid-card {
    position: relative;
    width: 100%;
  }

  .news-grid-card.is-paged-hidden {
    display: none;
  }

  .news-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .news-thumb-figure {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .news-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #0d0d0d;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .news-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity var(--transition-normal, 0.3s ease), transform var(--transition-normal, 0.3s ease);
  }

  .news-card-link:hover .news-thumb-img {
    opacity: 0.8;
    transform: scale(1.02);
  }

  .news-date-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #e0e0e0;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .widget-image-caption {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }

  .caption-client {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #777777;
  }

  .caption-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 1.125rem;
    color: #ffffff;
    line-height: 1.35;
    font-weight: 300;
    margin: 0;
  }

  .caption-excerpt {
    font-size: 0.8125rem;
    color: #888888;
    line-height: 1.5;
    margin: 0.35rem 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Paginação / Carregar Mais */
  .load-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 4rem;
  }

  .btn-load-more {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background-color: #0f0f0f;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.875rem 2rem;
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    cursor: pointer;
    transition: all var(--transition-normal, 0.25s ease);
  }

  .btn-load-more:hover {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-badge {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .btn-icon {
    font-size: 1rem;
    transition: transform var(--transition-normal, 0.25s ease);
  }

  .btn-load-more:hover .btn-icon {
    transform: translateY(2px);
  }

  /* Empty State */
  .empty-news-card {
    max-width: 640px;
    margin: 4rem auto;
    text-align: center;
    padding: 3.5rem 2rem;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .empty-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .empty-desc {
    font-size: 1rem;
    color: #999999;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .empty-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-empty-contact {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    border-radius: 999px;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition-normal, 0.25s ease);
  }

  .btn-empty-contact:hover {
    background: #e0e0e0;
    transform: translateY(-2px);
  }

  .btn-empty-back {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background: transparent;
    color: #ffffff;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition-normal, 0.25s ease);
  }

  .btn-empty-back:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  @media (max-width: 1024px) {
    .news-4col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .container-news {
      padding: 0 1.25rem;
    }

    .news-4col-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
