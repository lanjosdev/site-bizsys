---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Página não encontrada';
const pageDescription = 'Lamentamos! A página que você está buscando não está disponível.';

// Flag de busca: sincronizada com Header.astro, será ativada na Fase 4 junto com a rota /busca
const enableSearch = false;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <section class="section-error-404" aria-label="Página não encontrada">
    <div class="container error-container">
      <h1 class="error-title">Esta página não foi encontrada!</h1>
      <p class="error-text">
        Lamentamos! A página que você está buscando não está disponível.
        {enableSearch && (
          <>
            <br />
            <span>Talvez você possa tentar uma nova busca.</span>
          </>
        )}
      </p>

      {enableSearch && (
        <form action="/busca" method="get" class="error-search-form" role="search">
          <label for="error-search-input" class="sr-only">Pesquisa</label>
          <input
            type="search"
            id="error-search-input"
            name="q"
            class="error-search-input"
            placeholder="Pesquisa"
            autocomplete="off"
          />
        </form>
      )}

      <div class="error-action-wrap">
        <a href="/" class="error-home-link animated-link">
          VOLTAR À PÁGINA INICIAL
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-error-404 {
    min-height: calc(100vh - var(--header-height) - 140px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    background-color: #000000;
  }

  .error-container {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-title {
    font-size: clamp(32px, 5.5vw, 56px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin: 0 0 24px;
  }

  .error-text {
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 40px;
    max-width: 620px;
  }

  .error-search-form {
    width: 100%;
    max-width: 480px;
    margin: 0 auto 40px;
  }

  .error-search-input {
    width: 100%;
    height: 48px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.85);
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    padding: 0 16px;
    outline: none;
    box-sizing: border-box;
    transition: border-color var(--transition-fast);
  }

  .error-search-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .error-search-input:focus {
    border-color: #ffffff;
  }

  .error-action-wrap {
    margin-top: 8px;
  }

  .error-home-link {
    display: inline-block;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
    transition: color var(--transition-fast), border-color var(--transition-fast), opacity var(--transition-fast);
  }

  .error-home-link:hover {
    border-bottom-color: #ffffff;
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .section-error-404 {
      padding: 60px 20px;
      min-height: calc(100vh - var(--header-height) - 100px);
    }

    .error-title {
      letter-spacing: -0.5px;
      margin-bottom: 18px;
    }

    .error-text {
      margin-bottom: 32px;
    }

    .error-home-link {
      border-bottom-color: #ffffff;
      padding: 12px 4px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
