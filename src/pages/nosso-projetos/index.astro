---
import BaseLayout from '../../layouts/BaseLayout.astro';

const pageTitle = 'Work';
const pageDescription = 'Digital, Cenografia, Produto. A Bizsys trabalha com foco nessas três frentes de desenvolvimento.';

// Cases Selecionados fiéis ao original do Elementor
const selectedCases = [
  { title: '#EntubadosSony', client: 'Canal Sony', tag: 'Lives', link: '/nosso-projetos' },
  { title: 'Luna Rubi', client: 'Natura', tag: 'Aromatizador', link: '/nosso-projetos' },
  { title: 'Chegou Itubaína Guaraná', client: 'Itubaína', tag: 'Especiais', link: '/nosso-projetos' },
  { title: 'Destrava Essa Conquista', client: 'Trident', tag: 'Especiais', link: '/nosso-projetos' },
  { title: 'O Torcedor Impossível', client: 'SBT', tag: 'Especiais', link: '/nosso-projetos' },
  { title: 'Entrega Elétrica', client: 'Rappi', tag: 'Especiais', link: '/nosso-projetos' },
];

// Últimos Cases (Grid de 4 colunas fiel ao baseline)
const ultimosCases = [
  { title: 'Mega McFritas', client: "McDonald's", image: '/images/cases/mccode-mcdonalds.png' },
  { title: 'Giga Gloob', client: 'Globo', image: '/images/cases/strangerama-netflix.png' },
  { title: '#UberNaAvenida', client: 'Uber', image: '/images/cases/algoritmo-da-vida.png' },
  { title: 'The GPP Flare Experience', client: 'GPP', image: '/images/cases/mia-whiskas.jpg' },
  { title: 'Experiência Keep Walking', client: 'Johnnie Walker', image: '/images/cases/batuque-challenge-chevrolet.jpg' },
  { title: 'Bonde da Curtição', client: 'Engov', image: '/images/cases/mccode-mcdonalds.png' },
  { title: 'Energia Verde', client: 'Heineken', image: '/images/cases/strangerama-netflix.png' },
  { title: 'La Casa De Papel Parte 5', client: 'Netflix', image: '/images/cases/algoritmo-da-vida.png' },
  { title: 'Verdades Secretas II', client: 'Globoplay', image: '/images/cases/mia-whiskas.jpg' },
  { title: 'Maradona: Conquista De Um Sonho', client: 'Amazon Prime Video', image: '/images/cases/batuque-challenge-chevrolet.jpg' },
  { title: 'Família Addams 2', client: 'Universal Pictures', image: '/images/cases/mccode-mcdonalds.png' },
  { title: 'O Esquadrão Suicida', client: 'HBO Max', image: '/images/cases/strangerama-netflix.png' },
  { title: 'Lil Sugar', client: 'Hip Hop Public Health e Area 23', image: '/images/cases/algoritmo-da-vida.png' },
  { title: 'Olimpíadas 2021', client: 'SporTV', image: '/images/cases/mia-whiskas.jpg' },
  { title: 'Voz do Fernandão', client: 'Adidas', image: '/images/cases/batuque-challenge-chevrolet.jpg' },
  { title: '#BatuqueChallenge', client: 'Chevrolet', image: '/images/cases/batuque-challenge-chevrolet.jpg' },
  { title: 'Você Nunca Esteve Sozinha', client: 'Globoplay', image: '/images/cases/strangerama-netflix.png' },
  { title: 'Nova Devassa', client: 'Devassa', image: '/images/cases/mccode-mcdonalds.png' },
  { title: 'Cozinha Às Cegas', client: 'Maggi', image: '/images/cases/mia-whiskas.jpg' },
];

const categories = [
  { name: 'Lives', slug: 'lives', isGray: false },
  { name: 'AR', slug: 'ar', isGray: true },
  { name: 'Sensor de Movimento', slug: 'sensor-de-movimento', isGray: false },
  { name: 'Sampling', slug: 'sampling', isGray: true },
  { name: 'Cenografia', slug: 'cenografia', isGray: false },
  { name: 'Player de Áudio', slug: 'player-de-audio', isGray: true },
  { name: 'LED', slug: 'led', isGray: false },
  { name: 'Impressão Lenticular', slug: 'impressao-lenticular', isGray: true },
  { name: 'WebApp', slug: 'webapp', isGray: false },
  { name: 'Aromatizador', slug: 'aromatizador', isGray: true },
  { name: 'Projetos Especiais', slug: 'projetos-especiais', isGray: false },
  { name: 'Produto', slug: 'produto', isGray: true },
  { name: 'OOH', slug: 'ooh', isGray: false },
  { name: 'IA', slug: 'ia', isGray: true },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="work-page">
    <!-- 1. HERO COM AS 3 FRENTES (Fiel a elementor-element de work.html) -->
    <section class="section-work-hero" aria-label="Frentes de Atuação">
      <div class="container container-work">
        <div class="frentes-header">
          <h1 class="frente-title">Digital</h1>
          <h1 class="frente-title">Cenografia</h1>
          <h1 class="frente-title">Produto</h1>
        </div>
        <p class="frentes-desc">
          A Bizsys trabalha com foco nessas três frentes de desenvolvimento, que são compostas por especialistas em Tecnologia, Produção, Design, Eletrônica e Mecânica.
        </p>
      </div>
    </section>

    <!-- 2. CASES SELECIONADOS (Fiel a "Cases Selecionados" de work.html) -->
    <section class="section-selected-cases" aria-label="Cases Selecionados">
      <div class="container container-work">
        <h2 class="work-section-title">Cases Selecionados</h2>
        <div class="selected-cases-list">
          {selectedCases.map((item) => (
            <div class="selected-case-row">
              <span class="case-col-title">{item.title}</span>
              <span class="case-col-client">{item.client}</span>
              <span class="case-col-tag">{item.tag}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. ÚLTIMOS CASES (Grid de 4 colunas fiel a work.html) -->
    <section class="section-ultimos-cases" aria-label="Últimos Cases">
      <div class="container container-work">
        <h2 class="work-section-title">Últimos Cases</h2>
        <div class="cases-4col-grid">
          {ultimosCases.map((c) => (
            <article class="case-grid-card">
              <div class="case-thumb-box">
                <img
                  src={c.image}
                  alt={c.title}
                  width="720"
                  height="405"
                  class="case-thumb-img"
                  loading="lazy"
                />
              </div>
              <div class="case-grid-info">
                <h3 class="case-card-title">{c.title}</h3>
                <p class="case-card-client">{c.client}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. NAVEGUE POR CATEGORIA (Fiel a work.html) -->
    <section class="section-work-categories" aria-label="Categorias">
      <div class="container container-work">
        <h2 class="work-section-title">Ou navegue por categoria</h2>
        <div class="categories-text-wrap">
          {categories.map((cat) => (
            <a
              href={`/nosso-projetos?categoria=${cat.slug}`}
              class:list={['work-cat-link', cat.isGray ? 'is-gray' : 'is-white']}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .work-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 100px;
  }

  .container-work {
    max-width: 1120px;
  }

  /* 1. HERO */
  .section-work-hero {
    padding: 160px 0 60px 0;
  }

  .frentes-header {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin-bottom: 24px;
  }

  .frente-title {
    font-family: var(--font-primary);
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -3.5px;
    color: #ffffff;
    margin: 0;
  }

  .frentes-desc {
    font-family: var(--font-primary);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 300;
    line-height: 34px;
    color: #ffffff;
    max-width: 900px;
  }

  /* TÍTULOS COMUNS */
  .work-section-title {
    font-family: var(--font-primary);
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 40px;
  }

  /* 2. CASES SELECIONADOS */
  .section-selected-cases {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .selected-cases-list {
    display: flex;
    flex-direction: column;
  }

  .selected-case-row {
    display: grid;
    grid-template-columns: 2fr 1.5fr 1fr;
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-primary);
    font-size: 18px;
    font-weight: 300;
    color: #ffffff;
    align-items: center;
    transition: background-color var(--transition-fast);
  }

  .selected-case-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .case-col-client, .case-col-tag {
    color: #656362;
    font-size: 16px;
  }

  /* 3. ÚLTIMOS CASES (4 COLUNAS) */
  .section-ultimos-cases {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .cases-4col-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px 24px;
  }

  @media (min-width: 640px) {
    .cases-4col-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cases-4col-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 36px 24px;
    }
  }

  .case-grid-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-thumb-box {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #080808;
    border: 1px solid var(--color-border);
  }

  .case-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .case-grid-card:hover .case-thumb-img {
    transform: scale(1.04);
  }

  .case-grid-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .case-card-title {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.3;
  }

  .case-card-client {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 300;
    color: #656362;
  }

  /* 4. CATEGORIAS */
  .section-work-categories {
    padding: 80px 0;
    border-top: 1px solid var(--color-border);
  }

  .categories-text-wrap {
    font-family: var(--font-primary);
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -3px;
  }

  .work-cat-link {
    display: inline;
    text-decoration: none;
    margin-right: 18px;
    transition: opacity var(--transition-fast), color var(--transition-fast);
  }

  .work-cat-link.is-white {
    color: #ffffff;
  }

  .work-cat-link.is-gray {
    color: #656362;
  }

  .work-cat-link:hover {
    color: #ffffff;
    opacity: 0.7;
  }

  @media (max-width: 767px) {
    .section-work-hero {
      padding: 120px 0 40px 0;
    }
    .frentes-header {
      flex-direction: column;
      gap: 8px;
    }
    .selected-case-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .categories-text-wrap {
      font-size: 26px;
      line-height: 34px;
      letter-spacing: -1px;
    }
  }
</style>
