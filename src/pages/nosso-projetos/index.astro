---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories, getCategoryMap, FEATURED_CASES } from '../../data/wpData';

const pageTitle = 'Portfólio';
const pageDescription = 'Conheça nossos cases de criatividade, tecnologia e engenharia de produto desenvolvidos para as maiores marcas do mundo.';

const allPosts = getPosts();
const categories = getCategories().filter((c) => c.count > 0 && c.slug !== 'sem-categoria' && c.slug !== 'news');
const categoryMap = getCategoryMap();

// Sanitiza título de entidades HTML comuns do WordPress
function sanitizeTitle(title: string): string {
  return title
    .replace(/&#8211;/g, '–')
    .replace(/&#8217;/g, "'")
    .replace(/&#8220;/g, '“')
    .replace(/&#8221;/g, '”')
    .replace(/&#038;/g, '&')
    .replace(/&amp;/g, '&');
}

// Mapeia posts com suas categorias e imagem destacada
const portfolioItems = allPosts.map((post) => {
  const featuredMedia = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || '';
  const postCategories = post.categories.map((catId) => categoryMap.get(catId) || '').filter(Boolean);
  const primaryCategory = postCategories[0] || 'Projetos Especiais';

  return {
    id: post.id,
    slug: post.slug,
    title: sanitizeTitle(post.title?.rendered || 'Projeto Bizsys'),
    category: primaryCategory,
    categorySlugs: postCategories.map((c) => c.toLowerCase().replace(/\s+/g, '-')),
    image: featuredMedia,
    date: post.date ? new Date(post.date).getFullYear() : 2022,
  };
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="portfolio-page">
    <!-- Hero / Apresentação -->
    <section class="portfolio-hero">
      <div class="container portfolio-hero-inner">
        <span class="section-tag">NOSSO TRABALHO</span>
        <h1 class="portfolio-main-title">Digital. Cenografia. Produto.</h1>
        <p class="portfolio-manifesto">
          A Bizsys trabalha com foco nessas três frentes de desenvolvimento, que são compostas por especialistas em Tecnologia, Produção, Design, Eletrônica e Mecânica.
        </p>
      </div>
    </section>

    <!-- Cases em Super Destaque (Flagships) -->
    <section class="flagship-section">
      <div class="container">
        <h2 class="sub-header-title">Cases em Destaque</h2>
        <div class="flagship-grid">
          {FEATURED_CASES.map((item) => (
            <article class="flagship-card">
              <div class="flagship-thumb-wrapper">
                <img
                  src={item.image}
                  alt={`${item.title} - ${item.client}`}
                  width="720"
                  height="405"
                  class="flagship-thumb"
                  loading="eager"
                />
                <span class="flagship-badge">{item.category}</span>
              </div>
              <div class="flagship-info">
                <h3 class="flagship-title">{item.title}</h3>
                <p class="flagship-client">{item.client}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Filtros de Categoria -->
    <section class="filter-section" id="cases">
      <div class="container filter-container">
        <div class="filter-bar" role="tablist" aria-label="Filtrar por categoria">
          <button
            type="button"
            class="filter-btn active"
            data-category="todos"
            role="tab"
            aria-selected="true"
          >
            Todos ({portfolioItems.length})
          </button>
          {categories.map((cat) => (
            <button
              type="button"
              class="filter-btn"
              data-category={cat.slug}
              role="tab"
              aria-selected="false"
            >
              {cat.name} ({cat.count})
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Grid Completo de Projetos -->
    <section class="portfolio-grid-section">
      <div class="container">
        <div id="projects-grid" class="projects-grid">
          {portfolioItems.map((item) => (
            <article
              class="project-item"
              data-categories={item.categorySlugs.join(' ')}
            >
              <div class="project-thumb-box">
                {item.image ? (
                  <img
                    src={item.image}
                    alt={item.title}
                    width="640"
                    height="360"
                    class="project-thumb-img"
                    loading="lazy"
                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                  />
                ) : null}
                <div class="project-thumb-fallback" style={item.image ? 'display: none;' : 'display: flex;'}>
                  <span class="fallback-icon">BIZSYS</span>
                </div>
                <div class="project-overlay">
                  <span class="project-year">{item.date}</span>
                </div>
              </div>
              <div class="project-meta">
                <span class="project-category-tag">{item.category}</span>
                <h3 class="project-title">{item.title}</h3>
              </div>
            </article>
          ))}
        </div>

        <div id="empty-state" class="empty-state" style="display: none;">
          <p>Nenhum case encontrado para esta categoria no momento.</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .portfolio-page {
    background-color: var(--color-bg);
  }

  /* Hero */
  .portfolio-hero {
    padding: 160px 0 80px;
    background: radial-gradient(circle at 50% 20%, #151515 0%, #000000 80%);
    border-bottom: 1px solid var(--color-border);
  }

  .portfolio-hero-inner {
    max-width: 900px;
  }

  .section-tag {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.15em;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .portfolio-main-title {
    font-size: clamp(36px, 6vw, 72px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .portfolio-manifesto {
    font-size: clamp(17px, 2vw, 22px);
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* Flagship Cases */
  .flagship-section {
    padding: 80px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: #030303;
  }

  .sub-header-title {
    font-size: clamp(24px, 3.5vw, 36px);
    font-weight: 300;
    letter-spacing: -1px;
    color: #ffffff;
    margin-bottom: 36px;
  }

  .flagship-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .flagship-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .flagship-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
    }
  }

  .flagship-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .flagship-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .flagship-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .flagship-card:hover .flagship-thumb {
    transform: scale(1.04);
  }

  .flagship-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    padding: 4px 10px;
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 3px;
    font-size: 11px;
    color: #ffffff;
    text-transform: uppercase;
  }

  .flagship-title {
    font-size: 19px;
    font-weight: 300;
    color: #ffffff;
  }

  .flagship-client {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  /* Filter Bar */
  .filter-section {
    position: sticky;
    top: var(--header-height);
    background-color: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 50;
    padding: 16px 0;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .filter-bar::-webkit-scrollbar {
    display: none;
  }

  .filter-btn {
    padding: 8px 18px;
    background-color: transparent;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    white-space: nowrap;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.4);
  }

  .filter-btn.active {
    background-color: #ffffff;
    color: #000000;
    border-color: #ffffff;
    font-weight: 400;
  }

  /* Grid de Projetos */
  .portfolio-grid-section {
    padding: 80px 0 120px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px 32px;
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-item {
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform var(--transition-normal);
  }

  .project-item:hover {
    transform: translateY(-4px);
  }

  .project-thumb-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .project-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .project-item:hover .project-thumb-img {
    transform: scale(1.05);
  }

  .project-thumb-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #111111 0%, #1e1e1e 100%);
  }

  .fallback-icon {
    font-size: 18px;
    letter-spacing: 0.2em;
    font-weight: 300;
    color: rgba(255, 255, 255, 0.4);
  }

  .project-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 16px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    display: flex;
    justify-content: flex-end;
  }

  .project-year {
    font-size: 12px;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.7);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .project-category-tag {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .project-title {
    font-size: 18px;
    font-weight: 300;
    line-height: 1.3;
    color: #ffffff;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: var(--color-text-secondary);
    font-size: 16px;
  }

  @media (max-width: 767px) {
    .portfolio-hero {
      padding: 120px 0 60px;
    }
    .flagship-section,
    .portfolio-grid-section {
      padding: 50px 0;
    }
  }
</style>

<script>
  function setupPortfolioFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const projectItems = document.querySelectorAll<HTMLElement>('.project-item');
    const emptyState = document.getElementById('empty-state');

    function applyFilter(targetCategory: string) {
      let visibleCount = 0;

      projectItems.forEach((item) => {
        const itemCategories = item.dataset.categories || '';
        if (targetCategory === 'todos' || itemCategories.includes(targetCategory)) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      filterButtons.forEach((btn) => {
        const isMatch = btn.dataset.category === targetCategory;
        btn.classList.toggle('active', isMatch);
        btn.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });
    }

    // Clique nos botões de filtro
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category || 'todos';
        applyFilter(cat);

        // Atualizar URL query param suavemente sem reload
        const newUrl = new URL(window.location.href);
        if (cat === 'todos') {
          newUrl.searchParams.delete('categoria');
        } else {
          newUrl.searchParams.set('categoria', cat);
        }
        window.history.replaceState({}, '', newUrl.toString());
      });
    });

    // Ler filtro inicial da URL (ex: ?categoria=ooh)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('categoria');
    if (initialCategory) {
      applyFilter(initialCategory);
    }
  }

  setupPortfolioFilter();
  document.addEventListener('astro:after-swap', setupPortfolioFilter);
</script>
