---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AWARDS_LIST, CLIENTS_LIST } from '../data/wpData';

const pageTitle = 'Sobre Nós';
const pageDescription = 'A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.';

// Divisão fiel dos clientes em 3 colunas de 26 itens conforme baseline original do Elementor
const clientCols = [
  CLIENTS_LIST.slice(0, 26),
  CLIENTS_LIST.slice(26, 52),
  CLIENTS_LIST.slice(52),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="sobre-page">
    <!-- 1. HERO COM MANIFESTO CENTRALIZADO (Fiel a elementor-element-4fb33d0d & dafa2db) -->
    <section class="section-sobre-hero" aria-label="Apresentação">
      <div class="container container-sobre">
        <h1 class="sobre-headline">
          A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.
        </h1>
      </div>
    </section>

    <!-- 2. VÍDEO SHOWREEL EMBED INLINE (Fiel a elementor-element-0f0e02d) -->
    <section class="section-sobre-video" aria-label="Vídeo Showreel">
      <div class="container container-sobre">
        <div class="video-aspect-box">
          <iframe
            class="video-player"
            src="https://www.youtube.com/embed/IfXxwk2Nt3k?controls=1&rel=0&playsinline=1"
            title="Bizsys Showreel"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- 3. MÉTODO (Fiel a elementor-element-3499b39 & 3b33694 / 9509918) -->
    <section class="section-metodo" aria-label="Método">
      <div class="container container-sobre">
        <h2 class="section-sobre-title">Método</h2>

        <!-- Desktop: 3 Círculos Perfeitos com borda fina e texto centralizado (Fiel ao screenshot e Elementor 3b33694) -->
        <div class="metodo-grid-desktop">
          <div class="metodo-circle">
            <span class="metodo-circle-text">Ideia + Design</span>
          </div>
          <div class="metodo-circle">
            <span class="metodo-circle-text">Teste/Execução</span>
          </div>
          <div class="metodo-circle">
            <span class="metodo-circle-text">Manutenção/<br />Análise de dados</span>
          </div>
        </div>

        <!-- Mobile: Stack vertical com setas para baixo 🡣 (Fiel a 9509918) -->
        <div class="metodo-list-mobile">
          <div class="metodo-mobile-step">
            <span class="metodo-mobile-text">Ideia + Design</span>
            <span class="metodo-mobile-arrow" aria-hidden="true">🡣</span>
          </div>
          <div class="metodo-mobile-step">
            <span class="metodo-mobile-text">Teste/Execução</span>
            <span class="metodo-mobile-arrow" aria-hidden="true">🡣</span>
          </div>
          <div class="metodo-mobile-step">
            <span class="metodo-mobile-text">Manutenção/Análise de dados</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. TIME MULTIDISCIPLINAR (Fiel a elementor-element-7c49237) -->
    <section class="section-time" aria-label="Time Multidisciplinar">
      <div class="container container-time">
        <p class="time-text">
          Para viabilizar nossos projetos, estudamos as propostas e as desenvolvemos com o nosso time multidisciplinar, composto por especialistas em IT, Design, Engenharia Eletrônica e Mecânica, Publicidade, Cenografia, e Análise de Dados.
        </p>
      </div>
    </section>

    <!-- 5. CLIENTES EM 3 COLUNAS COMPACTAS E CENTRALIZADAS (Fiel a elementor-element-8adb46f & 7bd6d3a / ffc1e32) -->
    <section class="section-clientes" aria-label="Clientes">
      <div class="container container-sobre">
        <h2 class="section-sobre-title">Clientes</h2>
        <div class="clientes-cols-grid">
          {clientCols.map((col) => (
            <div class="clientes-col">
              <ul class="clientes-list">
                {col.map((client) => (
                  <li class="cliente-item">{client}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. PRÊMIOS & TABELA DE CASES EM LARGURA AMPLA (Fiel a elementor-element-b5c074f & 950270a / 04bfa0c / 3430dd7) -->
    <section id="premios" class="section-premios" aria-label="Prêmios">
      <div class="premios-container-wide">
        <h2 class="section-sobre-title">Prêmios</h2>

        <!-- Tabela Desktop com linhas divisórias de ponta a ponta (Fiel a 950270a & 04bfa0c) -->
        <div class="premios-table-desktop" role="table" aria-label="Prêmios conquistados">
          <!-- Cabeçalho da Tabela -->
          <div role="rowgroup">
            <div class="premios-header-row" role="row">
              <span class="col-header col-proj" role="columnheader">Projeto</span>
              <span class="col-header col-cli" role="columnheader">Cliente</span>
              <span class="col-header col-prem" role="columnheader">Prêmio</span>
              <span class="col-header col-ano" role="columnheader">Ano</span>
            </div>
          </div>

          <!-- Linhas de Premiações Desktop -->
          <div class="premios-body" role="rowgroup">
            {AWARDS_LIST.map((row) => (
              <div class="premios-item-row" role="row">
                <div class="col-data col-proj" role="cell">
                  <a href={row.link} class="premio-link animated-link">{row.project}</a>
                </div>
                <div class="col-data col-cli" role="cell">{row.client}</div>
                <div class="col-data col-prem" role="cell">
                  <a href={row.link} class="premio-link animated-link">
                    <Fragment set:html={row.award} />
                  </a>
                </div>
                <div class="col-data col-ano" role="cell">
                  <a href={row.link} class="premio-link-year animated-link">{row.year}</a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Cards Mobile (Fiel a 3430dd7) -->
        <div class="premios-cards-mobile">
          {AWARDS_LIST.map((row) => (
            <div class="premio-mobile-card">
              <div class="premio-mobile-col-left">
                <a href={row.link} class="premio-mobile-title">{row.project}</a>
                <span class="premio-mobile-client">{row.client}</span>
              </div>
              <div class="premio-mobile-col-right">
                <a href={row.link} class="premio-mobile-award">
                  <Fragment set:html={row.award} />
                </a>
                <a href={row.link} class="premio-mobile-year">{row.year}</a>
              </div>
            </div>
          ))}
        </div>

        <!-- 7. LINK "TODOS OS CASES PREMIADOS →" (Fiel ao screenshot e Elementor 842b691 / 5af187f) -->
        <div class="todos-cases-wrapper">
          <a href="/premios" class="todos-cases-link animated-link">
            Todos os cases premiados &rarr;
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sobre-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
  }

  .container-sobre {
    max-width: 1140px;
  }

  /* 1. HERO COM MANIFESTO */
  .section-sobre-hero {
    padding: 160px 0 60px 0;
  }

  .sobre-headline {
    font-family: var(--font-primary);
    font-size: clamp(32px, 4.2vw, 56px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2px;
    color: #ffffff;
    text-align: center;
    max-width: 960px;
    margin: 0 auto;
  }

  /* 2. VÍDEO INLINE */
  .section-sobre-video {
    padding: 30px 0 60px 0;
  }

  .video-aspect-box {
    position: relative;
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    margin: 0 auto;
    background-color: #050505;
    border: 1px solid var(--color-border);
  }

  .video-player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* TÍTULOS COMUNS */
  .section-sobre-title {
    font-family: var(--font-primary);
    font-size: 72px;
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2px;
    color: #ffffff;
    text-align: center;
    margin: 0 0 50px 0;
  }

  /* 3. MÉTODO */
  .section-metodo {
    padding: 60px 0 30px 0;
  }

  /* Desktop: 3 Círculos Perfeitos (aspect-ratio 1/1, border-radius 50%) */
  .metodo-grid-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .metodo-grid-desktop {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
      max-width: 960px;
      margin: 0 auto;
      align-items: center;
      justify-content: center;
    }
  }

  .metodo-circle {
    width: 100%;
    max-width: 290px;
    aspect-ratio: 1 / 1;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    box-sizing: border-box;
    transition: border-color var(--transition-normal);
  }

  .metodo-circle:hover {
    border-color: rgba(255, 255, 255, 0.85);
  }

  .metodo-circle-text {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 300;
    line-height: 27px;
    color: #ffffff;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    text-align: center;
  }

  /* Mobile Método: Stack vertical com setas 🡣 */
  .metodo-list-mobile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 25px;
  }

  @media (min-width: 768px) {
    .metodo-list-mobile {
      display: none;
    }
  }

  .metodo-mobile-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .metodo-mobile-text {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 300;
    line-height: 27px;
    color: #ffffff;
    text-align: center;
  }

  .metodo-mobile-arrow {
    color: var(--color-text-secondary);
    font-size: 24px;
    line-height: 27px;
    margin-top: 8px;
  }

  /* 4. TIME MULTIDISCIPLINAR */
  .section-time {
    padding: 50px 0 70px 0;
  }

  .container-time {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .time-text {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 300;
    line-height: 23.6px;
    color: #ffffff;
    text-align: justify;
    margin: 0;
  }

  @media (max-width: 767px) {
    .section-time {
      padding: 40px 0;
    }
    .time-text {
      text-align: left;
      font-size: 16px;
      line-height: 19.2px;
    }
  }

  /* 5. CLIENTES */
  .section-clientes {
    padding: 60px 0;
  }

  .clientes-cols-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    max-width: 720px;
    margin: 0 auto;
  }

  .clientes-col {
    display: flex;
    flex-direction: column;
  }

  .clientes-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .cliente-item {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 300;
    line-height: 23.6px;
    color: #ffffff;
    text-align: center;
    transition: opacity var(--transition-fast);
  }

  .cliente-item:hover {
    opacity: 0.75;
  }

  @media (max-width: 767px) {
    .clientes-cols-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 24px;
    }
    .cliente-item {
      font-size: 14px;
      line-height: 18.8px;
    }
  }

  /* 6. PRÊMIOS */
  .section-premios {
    padding: 60px 0 0 0;
    width: 100%;
  }

  .premios-container-wide {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
  }

  /* Desktop Table */
  .premios-table-desktop {
    display: none;
    width: 100%;
  }

  @media (min-width: 768px) {
    .premios-table-desktop {
      display: flex;
      flex-direction: column;
    }
  }

  .premios-header-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    align-items: center;
  }

  .col-header {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 19.2px;
    color: var(--color-text-secondary);
    text-align: center;
  }

  .premios-body {
    display: flex;
    flex-direction: column;
  }

  .premios-item-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 22px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    align-items: center;
    transition: background-color var(--transition-fast);
  }

  .premios-item-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .col-data {
    font-family: var(--font-primary);
    font-size: 24px;
    font-weight: 300;
    line-height: 27px;
    text-align: center;
  }

  .col-data.col-proj {
    color: #ffffff;
  }

  .col-data.col-cli {
    color: var(--color-text-secondary);
  }

  .col-data.col-prem {
    color: #ffffff;
  }

  .col-data.col-ano {
    color: var(--color-text-secondary);
  }

  .premio-link {
    color: #ffffff;
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .premio-link:hover {
    opacity: 0.75;
  }

  .premio-link-year {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .premio-link-year:hover {
    color: #ffffff;
  }

  /* Mobile Table / Cards (< 768px) */
  .premios-cards-mobile {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .premios-cards-mobile {
      display: none;
    }
  }

  .premio-mobile-card {
    display: flex;
    justify-content: space-between;
    padding: 16px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }

  .premio-mobile-col-left {
    width: 45%;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .premio-mobile-col-right {
    width: 55%;
    padding-right: 16px;
    display: flex;
    flex-direction: column;
    text-align: right;
  }

  .premio-mobile-title {
    font-family: var(--font-primary);
    font-size: 18px;
    font-weight: 300;
    line-height: 24px;
    color: #ffffff;
  }

  .premio-mobile-client {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 20px;
    color: var(--color-text-secondary);
    margin-top: 4px;
  }

  .premio-mobile-award {
    font-family: var(--font-primary);
    font-size: 18px;
    font-weight: 300;
    line-height: 24px;
    color: #ffffff;
  }

  .premio-mobile-year {
    font-family: var(--font-primary);
    font-size: 20px;
    font-weight: 300;
    line-height: 24px;
    color: var(--color-text-secondary);
    margin-top: 4px;
  }

  /* 7. TODOS OS CASES PREMIADOS */
  .todos-cases-wrapper {
    text-align: center;
    padding: 60px 0 150px 0;
  }

  .todos-cases-link {
    font-family: var(--font-primary);
    font-size: 32px;
    font-weight: 300;
    color: var(--color-text-secondary);
    text-decoration: none;
    display: inline-block;
    transition: color var(--transition-fast), opacity var(--transition-fast);
  }

  .todos-cases-link:hover {
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .premios-container-wide {
      padding: 0 20px;
    }
    .section-sobre-hero {
      padding: 120px 0 40px 0;
    }
    .sobre-headline {
      letter-spacing: -1.5px;
    }
    .section-sobre-title {
      font-size: 52px;
      line-height: 58.24px;
      margin-bottom: 30px;
    }
    .todos-cases-wrapper {
      padding: 30px 0 100px 0;
    }
    .todos-cases-link {
      font-size: 24px;
    }
  }
</style>
