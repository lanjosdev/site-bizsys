---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AWARDS_LIST, CLIENTS_LIST } from '../data/wpData';

const pageTitle = 'Sobre Nós';
const pageDescription = 'A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.';

const methodSteps = [
  {
    step: '01',
    title: 'Ideia + Design',
    desc: 'Estudamos o desafio criativo e desenhamos a solução técnica ideal, integrando design funcional, impacto visual e viabilidade de engenharia.',
  },
  {
    step: '02',
    title: 'Teste / Execução',
    desc: 'Prototipagem rápida, eletrônica embarcada, programação de software e fabricação cenográfica desenvolvidas por nossa equipe multidisciplinar.',
  },
  {
    step: '03',
    title: 'Manutenção / Análise de Dados',
    desc: 'Operação ativa em campo, suporte em tempo real, telemetria de sensores, engajamento e métricas de impacto para marcas.',
  },
];

const specialties = [
  'Tecnologia da Informação & Software',
  'Design & Experiência de Usuário',
  'Engenharia Eletrônica Embarcada',
  'Engenharia Mecânica & Automação',
  'Cenografia & Produção de Grande Porte',
  'Inteligência Artificial & Visão Computacional',
  'Projetos Especiais & Inovação',
  'Métricas & Análise de Dados',
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <!-- Hero / Missão -->
  <section class="about-hero">
    <div class="container about-hero-inner">
      <span class="section-tag">QUEM SOMOS</span>
      <h1 class="about-headline">
        A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.
      </h1>
    </div>
  </section>

  <!-- Método de Trabalho -->
  <section class="method-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Nosso Método</h2>
        <p class="section-subtitle">
          Um processo integrado da concepção do projeto à mensuração final de resultados.
        </p>
      </div>

      <div class="method-grid">
        {methodSteps.map((m) => (
          <div class="method-card">
            <span class="method-number">{m.step}</span>
            <h3 class="method-title">{m.title}</h3>
            <p class="method-desc">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Time Multidisciplinar -->
  <section class="team-section">
    <div class="container team-inner">
      <div class="team-content">
        <h2 class="section-title">Time Multidisciplinar</h2>
        <p class="team-manifesto">
          Para viabilizar nossos projetos, estudamos as propostas e as desenvolvemos com o nosso time multidisciplinar, composto por especialistas em IT, Design, Engenharia Eletrônica e Mecânica, Publicidade, Cenografia e Análise de Dados.
        </p>
        <p class="team-subtext">
          Somos online e offline. Somos especialistas em exceder os limites da tecnologia para oferecer inovação, dados e mídia para nossos parceiros em qualquer plataforma, canal ou formato.
        </p>
      </div>

      <div class="specialties-grid">
        {specialties.map((spec) => (
          <div class="specialty-item">
            <span class="specialty-bullet" aria-hidden="true">■</span>
            <span>{spec}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Clientes em Destaque -->
  <section class="clients-highlight-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <h2 class="section-title">Clientes</h2>
          <p class="section-subtitle">
            Marcas líderes que confiam em nossa engenharia para suas ativações de maior impacto.
          </p>
        </div>
        <a href="/nossos-clientes" class="view-all-link animated-link">
          Ver todos os clientes →
        </a>
      </div>

      <div class="clients-names-grid">
        {CLIENTS_LIST.slice(0, 36).map((client) => (
          <span class="client-name-item">{client}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção de Prêmios e Reconhecimento -->
  <section id="premios" class="awards-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">RECONHECIMENTO</span>
        <h2 class="section-title">Cases Premiados</h2>
        <p class="section-subtitle">
          Projetos reconhecidos com mais de 60 prêmios de excelência nos principais festivais de criatividade e inovação do mundo, incluindo 39 Cannes Lions, Clio Awards, Wave Festival, D&AD e Muse Awards.
        </p>
      </div>

      <!-- Tabela Responsiva de Premiações -->
      <div class="awards-table-wrapper">
        <table class="awards-table">
          <thead>
            <tr>
              <th scope="col">Projeto</th>
              <th scope="col">Cliente / Marca</th>
              <th scope="col">Premiação</th>
              <th scope="col">Ano</th>
            </tr>
          </thead>
          <tbody>
            {AWARDS_LIST.map((row) => (
              <tr class="award-row">
                <td class="col-project">
                  <a href={row.link} class="award-project-link animated-link">
                    {row.project}
                  </a>
                </td>
                <td class="col-client">{row.client}</td>
                <td class="col-award">
                  <span class="award-badge">{row.award}</span>
                </td>
                <td class="col-year">{row.year}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Header & Hero */
  .about-hero {
    padding: 160px 0 100px;
    background: radial-gradient(circle at 50% 20%, #151515 0%, #000000 80%);
    border-bottom: 1px solid var(--color-border);
  }

  .about-hero-inner {
    max-width: 1080px;
  }

  .section-tag {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.15em;
    font-weight: 400;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
    text-transform: uppercase;
  }

  .about-headline {
    font-size: clamp(32px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -2px;
    color: #ffffff;
  }

  /* Common Section Header */
  .section-header {
    margin-bottom: 50px;
    max-width: 800px;
  }

  .section-header-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 50px;
  }

  @media (min-width: 768px) {
    .section-header-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-title {
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .section-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .view-all-link {
    font-size: 14px;
    letter-spacing: 0.05em;
    color: #ffffff;
    white-space: nowrap;
  }

  /* Método */
  .method-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .method-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .method-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .method-card {
    padding: 40px 32px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: transform var(--transition-normal), border-color var(--transition-normal);
  }

  .method-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .method-number {
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .method-title {
    font-size: 24px;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  .method-desc {
    font-size: 15px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Time */
  .team-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: #050505;
  }

  .team-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 50px;
  }

  @media (min-width: 960px) {
    .team-inner {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 80px;
    }
  }

  .team-manifesto {
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 300;
    line-height: 1.5;
    color: #ffffff;
    margin-bottom: 20px;
  }

  .team-subtext {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 480px) {
    .specialties-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .specialty-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 14px;
    font-weight: 300;
    color: #ffffff;
  }

  .specialty-bullet {
    font-size: 8px;
    color: var(--color-text-secondary);
  }

  /* Clientes Grid */
  .clients-highlight-section {
    padding: 100px 0;
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-bg);
  }

  .clients-names-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .clients-names-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 960px) {
    .clients-names-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }

  .client-name-item {
    padding: 18px 20px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 15px;
    font-weight: 300;
    color: #ffffff;
    display: flex;
    align-items: center;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .client-name-item:hover {
    background-color: var(--color-surface-hover);
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Prêmios */
  .awards-section {
    padding: 100px 0 120px;
    background-color: #030303;
  }

  .awards-table-wrapper {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background-color: var(--color-surface);
  }

  .awards-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 680px;
  }

  .awards-table th {
    padding: 20px 24px;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    background-color: rgba(255, 255, 255, 0.02);
  }

  .awards-table td {
    padding: 20px 24px;
    font-size: 15px;
    color: var(--color-text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .award-row:last-child td {
    border-bottom: none;
  }

  .award-row:hover td {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .col-project {
    font-weight: 300;
    color: #ffffff;
  }

  .award-project-link {
    font-size: 16px;
    color: #ffffff;
  }

  .col-client {
    color: var(--color-text-secondary);
  }

  .award-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    font-size: 12px;
    color: #ffffff;
  }

  .col-year {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 767px) {
    .about-hero {
      padding: 120px 0 60px;
    }
    .method-section,
    .team-section,
    .clients-highlight-section,
    .awards-section {
      padding: 60px 0;
    }
  }
</style>
