---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AWARDS_LIST, CLIENTS_LIST } from '../data/wpData';

const pageTitle = 'Sobre Nós';
const pageDescription = 'A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.';

// Divisão dos clientes em 3 colunas fiéis ao layout de Sobre Nós do Elementor
const colSize = Math.ceil(CLIENTS_LIST.length / 3);
const clientCols = [
  CLIENTS_LIST.slice(0, colSize),
  CLIENTS_LIST.slice(colSize, colSize * 2),
  CLIENTS_LIST.slice(colSize * 2),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="sobre-page">
    <!-- 1. HERO COM MANIFESTO GIGANTE 72px (Fiel a elementor-element-4fb33d0d) -->
    <section class="section-sobre-hero" aria-label="Apresentação">
      <div class="container container-sobre">
        <h1 class="sobre-headline">
          A Bizsys constrói o ponto de contato entre marcas e público por meio da tecnologia, criatividade e engenharia de produto.
        </h1>
      </div>
    </section>

    <!-- 2. VÍDEO SHOWREEL EMBED INLINE (Fiel a elementor-element-0f0e02d) -->
    <section class="section-sobre-video" aria-label="Vídeo Showreel">
      <div class="container container-sobre">
        <div class="video-aspect-box">
          <iframe
            class="video-player"
            src="https://www.youtube.com/embed/IfXxwk2Nt3k?controls=1&rel=0&playsinline=1"
            title="Bizsys Showreel"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </section>

    <!-- 3. MÉTODO (Fiel a elementor-element-3499b39 & 3b33694) -->
    <section class="section-metodo" aria-label="Método">
      <div class="container container-sobre">
        <h2 class="section-sobre-title">Método</h2>
        <div class="metodo-grid">
          <div class="metodo-col">
            <span class="metodo-step">Ideia + Design <span class="arrow-down">🡣</span></span>
          </div>
          <div class="metodo-col">
            <span class="metodo-step">Teste/Execução <span class="arrow-down">🡣</span></span>
          </div>
          <div class="metodo-col">
            <span class="metodo-step">Manutenção/Análise de dados</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. TIME MULTIDISCIPLINAR (Fiel a elementor-element-7c49237) -->
    <section class="section-time" aria-label="Time Multidisciplinar">
      <div class="container container-sobre">
        <p class="time-text">
          Para viabilizar nossos projetos, estudamos as propostas e as desenvolvemos com o nosso time multidisciplinar, composto por especialistas em IT, Design, Engenharia Eletrônica e Mecânica, Publicidade, Cenografia, e Análise de Dados.
        </p>
      </div>
    </section>

    <!-- 5. CLIENTES EM 3 COLUNAS (Fiel a elementor-element-8adb46f & 7bd6d3a) -->
    <section class="section-clientes" aria-label="Clientes">
      <div class="container container-sobre">
        <h2 class="section-sobre-title">Clientes</h2>
        <div class="clientes-cols-grid">
          {clientCols.map((col) => (
            <div class="clientes-col">
              <ul class="clientes-list">
                {col.map((client) => (
                  <li class="cliente-item">{client}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. PRÊMIOS & TABELA DE CASES (Fiel a elementor-element-b5c074f & 950270a) -->
    <section id="premios" class="section-premios" aria-label="Prêmios">
      <div class="container container-sobre">
        <h2 class="section-sobre-title">Prêmios</h2>

        <div class="premios-table-container">
          <!-- Cabeçalho da Tabela -->
          <div class="premios-header-row" role="row">
            <span class="col-header col-proj" role="columnheader">Projeto</span>
            <span class="col-header col-cli" role="columnheader">Cliente</span>
            <span class="col-header col-prem" role="columnheader">Prêmio</span>
            <span class="col-header col-ano" role="columnheader">Ano</span>
          </div>

          <!-- Linhas de Premiações -->
          <div class="premios-body">
            {AWARDS_LIST.map((row) => (
              <div class="premios-item-row" role="row">
                <div class="col-data col-proj" role="cell">
                  <a href={row.link} class="premio-link animated-link">{row.project}</a>
                </div>
                <div class="col-data col-cli" role="cell">{row.client}</div>
                <div class="col-data col-prem" role="cell">{row.award}</div>
                <div class="col-data col-ano" role="cell">{row.year}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sobre-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 100px;
  }

  .container-sobre {
    max-width: 1120px;
  }

  /* 1. HERO */
  .section-sobre-hero {
    padding: 160px 0 60px 0;
  }

  .sobre-headline {
    font-family: var(--font-primary);
    font-size: clamp(32px, 5vw, 72px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -3.5px;
    color: #ffffff;
    margin: 0;
  }

  /* 2. VÍDEO INLINE */
  .section-sobre-video {
    padding: 30px 0 60px 0;
  }

  .video-aspect-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #050505;
    border: 1px solid var(--color-border);
  }

  .video-player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* TÍTULOS COMUNS */
  .section-sobre-title {
    font-family: var(--font-primary);
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 36px;
  }

  /* 3. MÉTODO */
  .section-metodo {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .metodo-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .metodo-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .metodo-step {
    font-family: var(--font-primary);
    font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 300;
    color: #ffffff;
    line-height: 1.4;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .arrow-down {
    color: #656362;
    font-size: 20px;
  }

  /* 4. TIME */
  .section-time {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .time-text {
    font-family: var(--font-primary);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 300;
    line-height: 34px;
    color: #ffffff;
    margin: 0;
  }

  /* 5. CLIENTES */
  .section-clientes {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .clientes-cols-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 640px) {
    .clientes-cols-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .clientes-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cliente-item {
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 300;
    line-height: 24px;
    color: #ffffff;
    opacity: 0.85;
    transition: opacity var(--transition-fast);
  }

  .cliente-item:hover {
    opacity: 1;
  }

  /* 6. PRÊMIOS */
  .section-premios {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .premios-table-container {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .premios-header-row {
    display: grid;
    grid-template-columns: 2fr 1.5fr 2fr 1fr;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .col-header {
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 300;
    letter-spacing: 0.1em;
    color: #656362;
    text-transform: uppercase;
  }

  .premios-body {
    display: flex;
    flex-direction: column;
  }

  .premios-item-row {
    display: grid;
    grid-template-columns: 2fr 1.5fr 2fr 1fr;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    align-items: center;
    transition: background-color var(--transition-fast);
  }

  .premios-item-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .col-data {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    color: #ffffff;
  }

  .col-cli, .col-ano {
    color: #656362;
  }

  .premio-link {
    color: #ffffff;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .section-sobre-hero {
      padding: 120px 0 40px 0;
    }
    .sobre-headline {
      letter-spacing: -1.5px;
    }
    .premios-header-row {
      display: none;
    }
    .premios-item-row {
      grid-template-columns: 1fr;
      gap: 6px;
      padding: 16px 0;
    }
    .col-cli, .col-prem, .col-ano {
      font-size: 14px;
    }
  }
</style>
