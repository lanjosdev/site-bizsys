---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Contato';
const pageDescription = 'Para mais infos, colaborações e ideias, você pode nos encontrar na Bizsys.';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || 'YOUR_ACCESS_KEY_HERE';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
>
  <div class="contato-page">
    <!-- 1. HEADER (Fiel a elementor-element de contato.html) -->
    <section class="section-contato-header" aria-label="Informações de Contato">
      <div class="container container-contato">
        <h1 class="contato-headline">
          Para mais infos, colaborações e ideias, você pode nos encontrar no:
        </h1>

        <!-- Cards de Email, Telefone, Endereço -->
        <div class="contato-info-row">
          <div class="info-block">
            <h2 class="info-title">Email</h2>
            <a href="mailto:orcamento@bizsys.com.br" class="info-link animated-link">
              orcamento@bizsys.com.br
            </a>
          </div>

          <div class="info-block">
            <h2 class="info-title">Telefone</h2>
            <a href="tel:+551132882121" class="info-link animated-link">
              +55 11 3288-2121
            </a>
          </div>

          <div class="info-block">
            <h2 class="info-title">Endereço</h2>
            <p class="info-address">
              Rua Hassib Mofarrej, 200<br />
              Vila Leopoldina, São Paulo
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. GOOGLE MAPS EMBED (Fiel a contato.html) -->
    <section class="section-mapa" aria-label="Localização">
      <div class="container container-contato">
        <div class="map-wrapper">
          <iframe
            class="map-iframe"
            src="https://maps.google.com/maps?q=R.%20Hassib%20Mofarrej%2C%20200%20-%20Vila%20Leopoldina%2C%20S%C3%A3o%20Paulo&t=m&z=16&output=embed&iwloc=near"
            title="Localização Bizsys no Google Maps"
            frameborder="0"
            scrolling="no"
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>

    <!-- 3. FORMULÁRIO (Fiel a contato.html + Web3Forms) -->
    <section class="section-form" aria-label="Formulário de Contato">
      <div class="container container-contato">
        <h2 class="form-title">Ou nos contate preenchendo o formulário abaixo:</h2>

        <form
          id="web3forms-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="contato-form"
        >
          <input type="hidden" name="access_key" value={web3formsAccessKey} />
          <input type="hidden" name="subject" value="Novo Contato via Site Bizsys" />
          <input type="hidden" name="from_name" value="Bizsys Website" />
          <input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" autocomplete="off" />

          <div class="form-fields">
            <div class="form-group">
              <label for="nome" class="form-label">Seu Nome *</label>
              <input type="text" id="nome" name="name" required class="form-input" placeholder="Seu Nome" />
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Endereço de E-mail *</label>
              <input type="email" id="email" name="email" required class="form-input" placeholder="exemplo@dominio.com" />
            </div>

            <div class="form-group full-width">
              <label for="assunto" class="form-label">Assunto *</label>
              <input type="text" id="assunto" name="subject" required class="form-input" placeholder="Assunto" />
            </div>

            <div class="form-group full-width">
              <label for="mensagem" class="form-label">Mensagem *</label>
              <textarea id="mensagem" name="message" rows="5" required class="form-input form-textarea" placeholder="Sua mensagem"></textarea>
            </div>
          </div>

          <div id="form-status" class="form-status-message" aria-live="polite"></div>

          <div class="form-actions">
            <button type="submit" id="submit-btn" class="submit-btn">
              <span class="btn-text">Enviar</span>
              <span class="btn-spinner" aria-hidden="true"></span>
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- 4. OPORTUNIDADES (Fiel a contato.html) -->
    <section class="section-oportunidades" aria-label="Oportunidades">
      <div class="container container-contato">
        <h2 class="oportunidades-title">Oportunidades</h2>
        <p class="oportunidades-text">
          No momento não temos vagas em aberto, mas se você quiser fazer parte do nosso banco de talentos, envie seu currículo para o e-mail:
          <a href="mailto:orcamento@bizsys.com.br" class="email-highlight animated-link">orcamento@bizsys.com.br</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .contato-page {
    background-color: #000000;
    color: #ffffff;
    width: 100%;
    padding-bottom: 100px;
  }

  .container-contato {
    max-width: 1120px;
  }

  /* 1. HEADER */
  .section-contato-header {
    padding: 160px 0 60px 0;
  }

  .contato-headline {
    font-family: var(--font-primary);
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -2.5px;
    color: #ffffff;
    margin-bottom: 50px;
  }

  .contato-info-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .contato-info-row {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .info-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .info-title {
    font-family: var(--font-primary);
    font-size: 14px;
    letter-spacing: 0.1em;
    font-weight: 300;
    color: #656362;
    text-transform: uppercase;
  }

  .info-link, .info-address {
    font-family: var(--font-primary);
    font-size: 18px;
    font-weight: 300;
    color: #ffffff;
    line-height: 1.4;
  }

  .info-address {
    font-style: normal;
  }

  /* 2. MAPA */
  .section-mapa {
    padding: 30px 0 60px 0;
  }

  .map-wrapper {
    position: relative;
    width: 100%;
    height: 380px;
    border: 1px solid var(--color-border);
    background-color: #050505;
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    border: none;
    filter: invert(90%) hue-rotate(180deg); /* Modo escuro suave para o mapa */
  }

  /* 3. FORMULÁRIO */
  .section-form {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .form-title {
    font-family: var(--font-primary);
    font-size: clamp(26px, 3.5vw, 44px);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -1.5px;
    color: #ffffff;
    margin-bottom: 40px;
  }

  .contato-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 900px;
  }

  .form-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .form-fields {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .form-label {
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 300;
    letter-spacing: 0.05em;
    color: #656362;
  }

  .form-input {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    padding: 14px 16px;
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 300;
    color: #ffffff;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .form-input:focus {
    border-color: #ffffff;
  }

  .form-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
  }

  .submit-btn {
    align-self: flex-start;
    padding: 14px 36px;
    background-color: #ffffff;
    color: #000000;
    font-family: var(--font-primary);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.05em;
    border: none;
    cursor: pointer;
    transition: opacity var(--transition-fast);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .submit-btn:hover {
    opacity: 0.85;
  }

  .submit-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(0, 0, 0, 0.2);
    border-top-color: #000000;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-left: 10px;
  }

  .submit-btn.is-loading .btn-spinner {
    display: inline-block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .form-status-message {
    font-size: 14px;
    transition: all var(--transition-fast);
  }

  .form-status-message.success {
    padding: 14px 18px;
    background-color: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #4ade80;
  }

  .form-status-message.error {
    padding: 14px 18px;
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #f87171;
  }

  /* 4. OPORTUNIDADES */
  .section-oportunidades {
    padding: 60px 0;
    border-top: 1px solid var(--color-border);
  }

  .oportunidades-title {
    font-family: var(--font-primary);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -2px;
    color: #ffffff;
    margin-bottom: 16px;
  }

  .oportunidades-text {
    font-family: var(--font-primary);
    font-size: 16px;
    font-weight: 300;
    line-height: 28px;
    color: #656362;
    max-width: 800px;
  }

  .email-highlight {
    color: #ffffff;
  }

  @media (max-width: 767px) {
    .section-contato-header {
      padding: 120px 0 40px 0;
    }
    .map-wrapper {
      height: 280px;
    }
  }
</style>

<script>
  function setupWeb3Forms() {
    const form = document.getElementById('web3forms-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const statusBox = document.getElementById('form-status');

    if (!form || !submitBtn || !statusBox) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');
      statusBox.className = 'form-status-message';
      statusBox.textContent = '';

      const formData = new FormData(form);
      const jsonObject = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(jsonObject),
        });

        const result = await response.json();

        if (response.ok && result.success) {
          statusBox.className = 'form-status-message success';
          statusBox.textContent = 'Mensagem enviada com sucesso! Em breve entraremos em contato.';
          form.reset();
        } else {
          statusBox.className = 'form-status-message error';
          statusBox.textContent = result.message || 'Não foi possível enviar a mensagem. Por favor, envie diretamente para orcamento@bizsys.com.br.';
        }
      } catch (err) {
        statusBox.className = 'form-status-message error';
        statusBox.textContent = 'Erro de conexão. Por favor, tente novamente ou envie para orcamento@bizsys.com.br.';
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('is-loading');
      }
    });
  }

  setupWeb3Forms();
  document.addEventListener('astro:after-swap', setupWeb3Forms);
</script>
