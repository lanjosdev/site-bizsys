---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Busca — Bizsys';
const pageDescription = 'Pesquise por projetos, tecnologias, clientes e novidades da Bizsys.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  isTransparentHeader={false}
  currentPath="/busca"
>
  <div class="search-page">
    <div class="container container-search">
      <!-- Breadcrumb -->
      <nav class="top-breadcrumb" aria-label="Navegação estrutural">
        <a href="/" class="back-link">
          <span class="back-arrow" aria-hidden="true">←</span>
          <span>Página Inicial</span>
        </a>
      </nav>

      <!-- Cabeçalho de Busca -->
      <header class="search-header">
        <span class="search-tag-label">Pesquisa</span>
        <h1 class="search-hero-title" id="search-title">Buscar no site</h1>
        <p class="search-hero-desc">
          Pesquise por clientes, tecnologias, categorias ou palavras-chave de todo o acervo da Bizsys.
        </p>

        <!-- Formulário de Busca Integrado -->
        <div class="search-box-wrap">
          <form id="page-search-form" class="page-search-form" role="search" onsubmit="return false;">
            <div class="search-input-inner">
              <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="search"
                id="search-query-input"
                class="search-query-input"
                placeholder="Ex: Nike, OOH, Cenografia, IA, Heineken..."
                autocomplete="off"
                aria-label="Termo de busca"
              />
              <button type="button" id="search-clear-btn" class="search-clear-btn" aria-label="Limpar busca" style="display: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </form>

          <!-- Termos Sugeridos Rápidos -->
          <div class="suggested-terms-wrap">
            <span class="suggested-label">Sugestões:</span>
            <div class="suggested-pills" id="suggested-pills">
              <button type="button" class="suggested-pill" data-term="OOH">OOH</button>
              <button type="button" class="suggested-pill" data-term="Cenografia">Cenografia</button>
              <button type="button" class="suggested-pill" data-term="IA">IA</button>
              <button type="button" class="suggested-pill" data-term="LED">LED</button>
              <button type="button" class="suggested-pill" data-term="Nike">Nike</button>
              <button type="button" class="suggested-pill" data-term="Heineken">Heineken</button>
              <button type="button" class="suggested-pill" data-term="McDonald's">McDonald's</button>
              <button type="button" class="suggested-pill" data-term="News">News</button>
            </div>
          </div>
        </div>
      </header>

      <!-- Contador de Resultados -->
      <div class="search-status-bar" id="search-status-bar" style="display: none;">
        <span class="status-counter" id="status-counter">0 resultados encontrados</span>
      </div>

      <!-- Container de Resultados -->
      <section class="search-results-section" aria-label="Resultados da pesquisa">
        <div class="results-list" id="results-container">
          <!-- Renderizado dinamicamente via JS client-side -->
        </div>

        <!-- Estado Inicial (sem busca digitada) -->
        <div class="search-empty-state" id="initial-state">
          <div class="empty-icon" aria-hidden="true">🔍</div>
          <h2 class="empty-title">O que você gostaria de explorar hoje?</h2>
          <p class="empty-desc">
            Digite um termo na barra de pesquisa acima ou selecione uma das sugestões para navegar pelos cases e inovações da Bizsys.
          </p>
        </div>

        <!-- Estado Nenhum Resultado Encontrado -->
        <div class="search-empty-state" id="no-results-state" style="display: none;">
          <div class="empty-icon" aria-hidden="true">🌾</div>
          <h2 class="empty-title">Nenhum resultado encontrado</h2>
          <p class="empty-desc" id="no-results-desc">
            Não encontramos correspondências para sua busca. Tente palavras mais gerais ou consulte nossas sugestões.
          </p>
          <div class="empty-actions">
            <a href="/categoria/todos" class="btn-empty-link">Explorar Todos os Projetos</a>
            <a href="/contato" class="btn-empty-contact">Fale Conosco</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  interface SearchItem {
    slug: string;
    id: number;
    title: string;
    client: string;
    year?: number;
    categories: string[];
    featuredImage: string;
    excerpt: string;
    date: string;
  }

  let searchIndex: SearchItem[] = [];
  let isIndexLoaded = false;

  function normalize(str: string): string {
    if (!str) return '';
    return str
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return '';
    const d = new Date(dateStr);
    return d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
  }

  function highlightMatch(text: string, query: string): string {
    if (!text || !query) return text || '';
    const cleanQuery = query.trim();
    if (!cleanQuery) return text;

    try {
      // Escape regex special chars
      const escaped = cleanQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const regex = new RegExp(`(${escaped})`, 'gi');
      return text.replace(regex, '<mark class="search-highlight">$1</mark>');
    } catch {
      return text;
    }
  }

  async function loadSearchIndex(): Promise<SearchItem[]> {
    if (isIndexLoaded) return searchIndex;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        searchIndex = await res.json();
        isIndexLoaded = true;
      }
    } catch (e) {
      console.error('Falha ao carregar search-index.json:', e);
    }
    return searchIndex;
  }

  function renderResults(results: SearchItem[], query: string) {
    const container = document.getElementById('results-container');
    const initialState = document.getElementById('initial-state');
    const noResultsState = document.getElementById('no-results-state');
    const noResultsDesc = document.getElementById('no-results-desc');
    const statusBar = document.getElementById('search-status-bar');
    const statusCounter = document.getElementById('status-counter');
    const titleHeader = document.getElementById('search-title');

    if (!container || !initialState || !noResultsState || !statusBar || !statusCounter || !titleHeader) return;

    if (!query) {
      container.innerHTML = '';
      initialState.style.display = 'block';
      noResultsState.style.display = 'none';
      statusBar.style.display = 'none';
      titleHeader.textContent = 'Buscar no site';
      return;
    }

    initialState.style.display = 'none';
    titleHeader.textContent = `Resultados da busca para: "${query}"`;

    if (results.length === 0) {
      container.innerHTML = '';
      statusBar.style.display = 'none';
      noResultsState.style.display = 'block';
      if (noResultsDesc) {
        noResultsDesc.textContent = `Não encontramos correspondências para "${query}". Verifique a ortografia ou tente termos mais amplos.`;
      }
      return;
    }

    noResultsState.style.display = 'none';
    statusBar.style.display = 'flex';
    statusCounter.textContent = `${results.length} ${results.length === 1 ? 'resultado encontrado' : 'resultados encontrados'}`;

    const html = results.map((item) => {
      const isNews = item.categories.includes('news');
      const catLabel = isNews ? 'NEWS' : (item.categories[0] ? item.categories[0].toUpperCase() : 'PROJETO');
      const highlightedTitle = highlightMatch(item.title, query);
      const highlightedClient = highlightMatch(item.client, query);
      const highlightedExcerpt = highlightMatch(item.excerpt, query);

      return `
        <article class="search-result-card">
          <a href="/posts/${item.slug}" class="search-card-thumb-link" aria-label="${item.title}">
            <div class="search-card-thumb-box">
              <img
                src="${item.featuredImage}"
                alt="${item.title}"
                width="800"
                height="450"
                class="search-card-img"
                loading="lazy"
              />
              <span class="search-card-tag">${catLabel}</span>
            </div>
          </a>
          <div class="search-card-content">
            <div class="search-card-meta">
              <span class="meta-client">${isNews ? 'Notícia Bizsys' : highlightedClient}</span>
              ${item.year ? `<span class="meta-dot">•</span><span class="meta-year">${item.year}</span>` : ''}
              ${item.date ? `<span class="meta-dot">•</span><span class="meta-date">${formatDate(item.date)}</span>` : ''}
            </div>
            <h2 class="search-card-title">
              <a href="/posts/${item.slug}" class="search-title-link">${highlightedTitle}</a>
            </h2>
            <p class="search-card-excerpt">${highlightedExcerpt}</p>
            <div class="search-card-footer">
              <a href="/posts/${item.slug}" class="search-action-link">
                CONTINUAR LENDO <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      `;
    }).join('');

    container.innerHTML = html;
  }

  async function performSearch(query: string) {
    const cleanQuery = query.trim();
    const clearBtn = document.getElementById('search-clear-btn');
    if (clearBtn) {
      clearBtn.style.display = cleanQuery ? 'flex' : 'none';
    }

    if (!cleanQuery) {
      renderResults([], '');
      return;
    }

    const items = await loadSearchIndex();
    const normQuery = normalize(cleanQuery);
    const queryTokens = normQuery.split(/\s+/).filter(Boolean);

    const matches = items.filter((item) => {
      const normTitle = normalize(item.title);
      const normClient = normalize(item.client);
      const normExcerpt = normalize(item.excerpt);
      const normCats = item.categories.map(normalize).join(' ');

      // Todos os tokens digitados precisam casar em algum campo
      return queryTokens.every((token) =>
        normTitle.includes(token) ||
        normClient.includes(token) ||
        normExcerpt.includes(token) ||
        normCats.includes(token)
      );
    });

    renderResults(matches, cleanQuery);
  }

  function setupSearchPage() {
    const input = document.getElementById('search-query-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn');
    const pillsWrap = document.getElementById('suggested-pills');

    if (!input) return;

    // 1. Ler termo da URL (?q=... ou ?s=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q') || urlParams.get('s') || '';

    if (initialQuery) {
      input.value = initialQuery;
      performSearch(initialQuery);
    } else {
      // Pré-carrega o índice em background
      loadSearchIndex();
    }

    // 2. Debounce na digitação
    let timeoutId: number | undefined;
    input.addEventListener('input', () => {
      const val = input.value;
      if (clearBtn) clearBtn.style.display = val.trim() ? 'flex' : 'none';
      clearTimeout(timeoutId);
      timeoutId = window.setTimeout(() => {
        // Atualiza a URL sem recarregar
        const url = new URL(window.location.href);
        if (val.trim()) {
          url.searchParams.set('q', val.trim());
          url.searchParams.delete('s');
        } else {
          url.searchParams.delete('q');
          url.searchParams.delete('s');
        }
        window.history.replaceState({}, '', url.toString());
        performSearch(val);
      }, 150);
    });

    // 3. Botão limpar
    clearBtn?.addEventListener('click', () => {
      input.value = '';
      input.focus();
      clearBtn.style.display = 'none';
      const url = new URL(window.location.href);
      url.searchParams.delete('q');
      url.searchParams.delete('s');
      window.history.replaceState({}, '', url.toString());
      performSearch('');
    });

    // 4. Cliques em termos sugeridos
    pillsWrap?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const term = target.getAttribute('data-term');
      if (term) {
        input.value = term;
        input.focus();
        const url = new URL(window.location.href);
        url.searchParams.set('q', term);
        url.searchParams.delete('s');
        window.history.replaceState({}, '', url.toString());
        performSearch(term);
      }
    });
  }

  setupSearchPage();
  document.addEventListener('astro:page-load', setupSearchPage);
</script>

<style>
  .search-page {
    background-color: #000000;
    color: #ffffff;
    min-height: 100vh;
    padding-top: calc(var(--header-height, 73px) + 2rem);
    padding-bottom: 6rem;
  }

  .container-search {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Breadcrumb */
  .top-breadcrumb {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #888888;
    text-decoration: none;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color var(--transition-normal, 0.25s ease);
  }

  .back-link:hover {
    color: #ffffff;
  }

  .back-arrow {
    font-size: 1.125rem;
    transition: transform var(--transition-normal, 0.25s ease);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }

  /* Cabeçalho da Busca */
  .search-header {
    margin-bottom: 3.5rem;
  }

  .search-tag-label {
    display: inline-block;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #656362;
    margin-bottom: 0.75rem;
  }

  .search-hero-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 300;
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .search-hero-desc {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    color: #9e9e9e;
    max-width: 720px;
    line-height: 1.5;
    margin: 0 0 2.5rem;
  }

  /* Caixa de Busca com Input */
  .search-box-wrap {
    max-width: 800px;
  }

  .page-search-form {
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .search-input-inner {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #0f0f0f;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    padding: 0.75rem 1.5rem;
    transition: border-color var(--transition-normal, 0.25s ease), box-shadow var(--transition-normal, 0.25s ease);
  }

  .search-input-inner:focus-within {
    border-color: #ffffff;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
  }

  .search-icon {
    color: #777777;
    margin-right: 0.875rem;
    flex-shrink: 0;
  }

  .search-query-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #ffffff;
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 1.125rem;
    font-weight: 300;
    outline: none;
  }

  .search-query-input::placeholder {
    color: #555555;
  }

  .search-clear-btn {
    display: none;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: #888888;
    cursor: pointer;
    padding: 4px;
    border-radius: 50%;
    margin-left: 8px;
    flex-shrink: 0;
    line-height: 1;
    transition: color var(--transition-normal, 0.2s ease), background-color var(--transition-normal, 0.2s ease), transform var(--transition-normal, 0.2s ease);
  }

  .search-clear-btn:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.12);
  }

  .search-clear-btn:active {
    transform: scale(0.9);
  }

  /* Reset scoped para input search */
  .search-query-input::-webkit-search-decoration,
  .search-query-input::-webkit-search-cancel-button,
  .search-query-input::-webkit-search-results-button,
  .search-query-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .search-query-input::-ms-clear,
  .search-query-input::-ms-reveal {
    display: none;
    width: 0;
    height: 0;
  }


  /* Termos Sugeridos */
  .suggested-terms-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .suggested-label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #666666;
  }

  .suggested-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .suggested-pill {
    background-color: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #a0a0a0;
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all var(--transition-normal, 0.2s ease);
  }

  .suggested-pill:hover {
    background-color: #222222;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  /* Status Bar */
  .search-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .status-counter {
    font-size: 0.9375rem;
    color: #888888;
    letter-spacing: 0.04em;
  }

  /* Lista de Resultados (Cards Horizontais fiéis ao OceanWP / WordPress) */
  .results-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  :global(.search-result-card) {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 2.5rem;
    align-items: center;
    background-color: #080808;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 1.5rem;
    transition: border-color var(--transition-normal, 0.3s ease), transform var(--transition-normal, 0.3s ease);
  }

  :global(.search-result-card:hover) {
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  :global(.search-card-thumb-link) {
    display: block;
    text-decoration: none;
  }

  :global(.search-card-thumb-box) {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    overflow: hidden;
    background-color: #121212;
  }

  :global(.search-card-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-normal, 0.3s ease), opacity var(--transition-normal, 0.3s ease);
  }

  :global(.search-result-card:hover .search-card-img) {
    transform: scale(1.03);
    opacity: 0.85;
  }

  :global(.search-card-tag) {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background-color: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  :global(.search-card-content) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  :global(.search-card-meta) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #777777;
  }

  :global(.meta-dot) {
    color: #444444;
  }

  :global(.search-card-title) {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
  }

  :global(.search-title-link) {
    color: #ffffff;
    text-decoration: none;
    transition: color var(--transition-normal, 0.25s ease);
  }

  :global(.search-title-link:hover) {
    color: #cccccc;
  }

  :global(.search-card-excerpt) {
    font-size: 0.9375rem;
    color: #999999;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.search-highlight) {
    background-color: rgba(255, 255, 255, 0.2);
    color: #ffffff;
    padding: 0.1em 0.25em;
    border-radius: 2px;
  }

  :global(.search-card-footer) {
    margin-top: 0.5rem;
  }

  :global(.search-action-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ffffff;
    text-decoration: none;
    font-weight: 500;
    transition: all var(--transition-normal, 0.25s ease);
  }

  :global(.search-action-link:hover) {
    color: #aaaaaa;
  }

  :global(.search-action-link:hover .arrow) {
    transform: translateX(4px);
  }

  :global(.arrow) {
    transition: transform var(--transition-normal, 0.25s ease);
  }

  /* Empty States */
  .search-empty-state {
    max-width: 600px;
    margin: 4rem auto;
    text-align: center;
    padding: 3.5rem 2rem;
    background-color: #0a0a0a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
  }

  .empty-icon {
    font-size: 2.75rem;
    margin-bottom: 1.25rem;
  }

  .empty-title {
    font-family: var(--font-primary, 'Good Sans', sans-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: #ffffff;
    margin: 0 0 1rem;
  }

  .empty-desc {
    font-size: 1rem;
    color: #999999;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .empty-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-empty-link {
    display: inline-block;
    padding: 0.75rem 1.75rem;
    background-color: #ffffff;
    color: #000000;
    text-decoration: none;
    border-radius: 999px;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all var(--transition-normal, 0.25s ease);
  }

  .btn-empty-link:hover {
    background-color: #e0e0e0;
    transform: translateY(-2px);
  }

